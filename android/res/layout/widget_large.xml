<?xml version="1.0" encoding="utf-8"?>
<!-- katta va baland o'lcham (masalan 4×3, 4×4, 2×3): hamma narsa ustma-ust, yoy markazda kattalashadi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_due" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Takror" android:textSize="10.5sp" android:textStyle="bold" android:letterSpacing="0.09" android:textAllCaps="true" android:textColor="#FFB27F" android:maxLines="1"/></LinearLayout>
            <LinearLayout android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/chip" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="7dp" android:paddingEnd="10dp">
                <ImageView android:id="@+id/fire" android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_fire" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
        <ImageView android:id="@+id/gauge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingTop="10dp">
            <TextView android:id="@+id/num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="60sp" android:textStyle="bold" android:textColor="#F7F5F1" android:includeFontPadding="false" android:maxLines="1"/>
            <TextView android:id="@+id/numcap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="so'z qoldi" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.09" android:textAllCaps="true" android:textColor="#99FFFFFF" android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                    <TextView android:id="@+id/s1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold" android:textColor="#F7F5F1" android:includeFontPadding="false"/>
                    <TextView android:id="@+id/s1u" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#A6FFFFFF"/>
                </LinearLayout>
                <TextView android:id="@+id/s1c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:textAllCaps="true" android:textColor="#8CFFFFFF" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                    <TextView android:id="@+id/s2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold" android:textColor="#F7F5F1" android:includeFontPadding="false"/>
                    <TextView android:id="@+id/s2u" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#A6FFFFFF"/>
                </LinearLayout>
                <TextView android:id="@+id/s2c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:textAllCaps="true" android:textColor="#8CFFFFFF" android:maxLines="1"/>
            </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/btn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/pill_due" android:gravity="center" android:text="Davom etish" android:textSize="15sp" android:textStyle="bold" android:textColor="#1A0F0A" android:maxLines="1"/>
</LinearLayout>
