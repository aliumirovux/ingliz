{"lessons":[{"n":1,"t":"Welcome!","uz":"tanishuv","dur":300.4,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/5/5f/5f00c78a-0f84-41e6-949d-bd808bcadf50.mp4","poster":"https://gdb.voanews.com/5f00c78a-0f84-41e6-949d-bd808bcadf50_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-one/3111026.html","s":[[200.78,202.63,"Hi, are you Anna?","Salom, siz Annamisiz?"],[202.7,204.53,"Yes. Hi there. Are you Pete?","Ha. Salom. Siz Petemisiz?"],[204.66,206.62,"I am Pete. Nice to meet you.","Men Peteman. Tanishganimdan xursandman."],[206.52,210.23,"Oh, let's try that again.","Oh, keling, qaytadan urinib ko'raylik."],[211.0,213.13,"I'm Anna. Nice to meet you.","Men Annaman. Tanishganimdan xursandman."],[213.16,214.09,"I'm Pete.","Men Peteman."],[214.66,217.25,"Anna, is that A-N-A?","Anna — bu A-N-A mi?"],[217.26,219.83,"No, A-N-N-A.","Yo'q, A-N-N-A."],[220.16,222.15,"Well, Anna with two n's.","Xo'p, ikkita «n» bilan Anna."],[222.66,226.59,"Welcome to 1400 Irving Street.","Irving ko'chasi, 1400-uyga xush kelibsiz."],[226.9,228.55,"My new apartment.","Mening yangi kvartiram."],[229.04,229.67,"Yes.","Ha."]]},{"n":2,"t":"Hello, I'm Anna!","uz":"tanishtirish","dur":300.4,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/4/42/4298a2ba-d665-4b1c-aaa1-502bbcb9b88d.mp4","poster":"https://gdb.voanews.com/4298a2ba-d665-4b1c-aaa1-502bbcb9b88d_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-2-hello/3113733.html","s":[[169.96,171.05,"Hi. Hey, Pete.","Salom. — Salom, Pete."],[171.42,172.49,"Who's your friend?","Do'stingiz kim?"],[173.0,175.27,"She is Anna. She is new to D.C.","Bu Anna. U Vashingtonga (D.C.) yangi kelgan."],[175.56,176.6,"Where are you from?","Qayerdansiz?"],[176.5,178.99,"I am from a small town.","Men kichik bir shaharchadanman."],[180.0,181.99,"Welcome to D.C. Thank you.","Vashingtonga xush kelibsiz. — Rahmat."],[182.02,182.93,"I'm Jonathan.","Men Jonatanman."],[183.4,185.09,"I'm in apartment B4.","Men B4-kvartiradaman."],[185.64,187.73,"I am in apartment C2.","Men C2-kvartiradaman."],[188.02,189.81,"Marsha is my roommate.","Marsha mening xonadoshim."],[190.38,191.73,"I know Marsha.","Men Marshani taniyman."],[191.9,193.09,"She is nice.","U yoqimli."],[193.88,196.77,"And I am in apartment D7.","Men esa D7-kvartiradaman."],[197.52,199.21,"I have to go now.","Men hozir ketishim kerak."],[199.2,199.93,"Oh.","O."],[200.42,202.47,"Remember to call Marsha at work.","Marshaga ishiga qo'ng'iroq qilishni unutmang."],[202.48,203.9,"Tell her you're here.","Unga shu yerdaligingizni ayting."],[203.8,205.14,"Right. Thanks, Pete.","Xo'p. Rahmat, Pete."],[205.04,207.04,"Nice to meet you.","Tanishganimdan xursandman."],[206.94,208.35,"You too. Bye.","Men ham. Xayr."],[210.58,213.81,"Apartment C2, here I come.","C2-kvartira, men kelyapman."]]},{"n":3,"t":"I'm Here!","uz":"uzr so'rash, telefonda","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/0/02/027f8fdd-e9b0-409c-8618-45be49fcefe8.mp4","poster":"https://gdb.voanews.com/027f8fdd-e9b0-409c-8618-45be49fcefe8_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-3-i-am-here/3126527.html","s":[[187.41,190.31,"I am in my new apartment.","Men yangi kvartiramdaman."],[190.66,191.37,"Great.","Zo'r."],[191.8,193.37,"I live with Marsha.","Men Marsha bilan yashayman."],[193.56,195.25,"We're roommates.","Biz xonadoshmiz."],[196.18,198.39,"I want to cook dinner.","Men kechki ovqat pishirmoqchiman."],[204.04,209.25,"Oh, is there a supermarket near here?","Oh, shu yaqin atrofda supermarket bormi?"],[210.36,211.37,"Marsha knows.","Marsha biladi."],[214.06,219.49,"Marsha's work number is 555-8986.","Marshaning ish raqami 555-8986."],[222.58,223.75,"Hello.","Allo."],[224.16,225.79,"Is this Marsha?","Bu Marshami?"],[225.74,227.89,"It is Anna. I am sorry.","Bu Anna. — Kechirasiz."],[227.84,229.31,"You have the wrong number.","Siz noto'g'ri raqam terdingiz."],[229.66,233.53,"Is this 555-8986?","Bu 555-8986 mi?"],[234.26,238.17,"No. This is 555-8689.","Yo'q. Bu 555-8689."],[239.42,241.42,"Oh, excuse me.","Oh, kechirasiz."],[241.32,242.39,"Okay. Bye.","Xo'p. Xayr."],[243.5,245.41,"One more time.","Yana bir marta."],[250.76,252.39,"Please be Marsha.","Iltimos, Marsha bo'lsin."],[255.12,257.4,"Hello. This is Marsha.","Allo. Bu Marsha."],[257.3,260.45,"Yes, Marsha. I want to cook dinner.","Ha, Marsha. Men kechki ovqat pishirmoqchiman."],[260.64,261.57,"Excuse me?","Nima dedingiz?"],[261.86,263.35,"Anna, is that you?","Anna, bu sizmisiz?"],[263.3,264.99,"Oh, yes. I am here.","Oh, ha. Men shu yerdaman."],[265.18,267.07,"Good. You are there.","Yaxshi. Siz u yerdasiz."],[267.22,270.03,"I want to find a supermarket.","Men supermarket topmoqchiman."],[270.1,271.49,"Oh, okay.","Oh, xo'p."],[271.68,276.41,"The supermarket is at 1500 Irving Street.","Supermarket Irving ko'chasi, 1500-uyda."],[276.52,278.35,"It is near the apartment.","U kvartiraga yaqin."],[278.54,279.13,"Great.","Zo'r."],[279.74,281.61,"Goodbye. Goodbye, Anna.","Xayr. — Xayr, Anna."],[283.56,288.07,"There is a big supermarket on our street.","Ko'chamizda katta supermarket bor."],[288.04,291.89,"And Marsha says, I am a good cook.","Marsha esa men yaxshi oshpazman deydi."],[293.0,295.09,"Until next time, bye.","Keyingi safargacha, xayr."]]},{"n":4,"t":"What Is It?","uz":"kundalik narsalar","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/c/c8/c829a13b-9764-4b89-ad70-1edbdc3d8013.mp4","poster":"https://gdb.voanews.com/c829a13b-9764-4b89-ad70-1edbdc3d8013_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-4/3168920.html","s":[[174.16,183.87,"Pete, hi.","Pete, salom."],[183.82,185.41,"Hi. We are here.","Salom. Biz keldik."],[185.7,187.23,"Hi, Anna. Hi, Marsha.","Salom, Anna. Salom, Marsha."],[187.32,187.89,"Hi.","Salom."],[188.48,189.93,"How are you two?","Ikkalangiz qalaysiz?"],[189.92,191.09,"I am great.","Men zo'rman."],[191.48,193.58,"You know Pete, I am new to D.C.","Bilasizmi, Pete, men Vashingtonga yangi kelganman."],[193.48,196.55,"The city is big.","Shahar katta."],[197.3,200.71,"Yeah, but you learn a little more every day.","Ha, lekin har kuni bir oz ko'proq o'rganasiz."],[201.18,202.41,"How's the new apartment?","Yangi kvartira qanday?"],[202.46,204.33,"The new apartment is great.","Yangi kvartira zo'r."],[204.82,206.25,"Let's get coffee.","Keling, qahva ichaylik."],[206.78,209.41,"Anna, do you have a pen?","Anna, sizda ruchka bormi?"],[220.8,222.89,"It is not a pen.","Bu ruchka emas."],[223.06,224.53,"It is a book.","Bu kitob."],[225.38,227.51,"It is a big book.","Bu katta kitob."],[227.82,229.47,"Yes, yes it is, Pete.","Ha, ha, shunday, Pete."],[229.64,231.51,"I know I have a pen, though.","Lekin bilaman, menda ruchka bor."],[235.22,243.28,"I have a...","Menda bir..."],[243.18,248.35,"It is not a pen, Anna.","Bu ruchka emas, Anna."],[249.22,250.35,"A toy?","O'yinchoqmi?"],[250.39,254.78,"I have a...","Menda bir..."],[254.68,257.57,"And it is a pillow.","Bu esa yostiq."],[260.12,263.37,"Pete, Marsha, I know I have a pen.","Pete, Marsha, bilaman, menda ruchka bor."],[265.88,270.73,"Anna, it is a map.","Anna, bu xarita."],[272.56,276.01,"Why do you have a map of the world?","Nega sizda dunyo xaritasi bor?"],[276.32,281.31,"Pete, Marsha, now I know I have a pen.","Pete, Marsha, endi bilaman, menda ruchka bor."],[284.76,289.09,"And now you have a lamp.","Endi esa sizda chiroq bor."],[289.66,290.71,"Anna, Anna.","Anna, Anna."],[291.52,292.97,"I have a pen.","Menda ruchka bor."],[293.42,294.57,"Let's get coffee.","Keling, qahva ichaylik."]]},{"n":5,"t":"Where Are You?","uz":"uy xonalari","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/c/ce/ce630bdd-1ffd-4c63-aca7-4bdff50fc7ba.mp4","poster":"https://gdb.voanews.com/ce630bdd-1ffd-4c63-aca7-4bdff50fc7ba_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-5-where-are-you/3168971.html","s":[[150.44,151.37,"Hello everyone!","Hammaga salom!"],[151.86,155.29,"Today my friend Marsha is at her friend's house.","Bugun do'stim Marsha o'z dugonasining uyida."],[155.44,157.59,"She says it is beautiful.","U uy chiroyli deydi."],[158.2,160.39,"I want to see this house.","Men bu uyni ko'rmoqchiman."],[161.16,162.37,"Here we are.","Mana, keldik."],[167.94,170.51,"Marsha, I am in the kitchen.","Marsha, men oshxonadaman."],[172.74,176.29,"It is a beautiful kitchen.","Bu chiroyli oshxona."],[176.92,178.81,"It is beautiful.","U chiroyli."],[179.18,182.73,"We cook in the kitchen.","Biz oshxonada ovqat pishiramiz."],[185.26,187.53,"I eat in the kitchen.","Men oshxonada ovqatlanaman."],[188.2,191.19,"We relax in the living room.","Biz mehmonxonada dam olamiz."],[192.06,196.71,"I relax in the living room.","Men mehmonxonada dam olaman."],[197.18,199.91,"Marsha, let's go upstairs.","Marsha, keling, yuqoriga chiqaylik."],[207.46,210.04,"Anna, where are you?","Anna, qayerdasiz?"],[209.94,212.09,"Marsha, I am in the bathroom.","Marsha, men hammomdaman."],[212.28,214.43,"I wash in the bathroom.","Men hammomda yuvinaman."],[220.82,223.01,"I am in the bedroom.","Men yotoqxonadaman."],[223.46,226.21,"We sleep in the bedroom.","Biz yotoqxonada uxlaymiz."],[227.74,229.73,"I sleep in the bedroom.","Men yotoqxonada uxlayman."]]},{"n":6,"t":"Where Is the Gym?","uz":"joy so'rash","dur":300.3,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/1/11/11171870-8eee-4a24-bef4-41af1b6898a0.mp4","poster":"https://gdb.voanews.com/11171870-8eee-4a24-bef4-41af1b6898a0_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-6-where-is-the-gym-/5781378.html","s":[[21.06,26.84,"Hi there, I'm Anna and I live in Washington, D.C.","Salom, men Annaman, Vashingtonda yashayman."],[26.74,31.57,"Every day I learn more about this great city.","Har kuni bu ajoyib shahar haqida ko'proq bilib olaman."],[32.32,36.11,"People in Washington like to work out.","Vashingtonda odamlar sport bilan shug'ullanishni yaxshi ko'radi."],[36.84,37.97,"Oh!","Oh!"],[38.56,40.87,"Hi, Pete, how's it going?","Salom, Pete, ishlar qalay?"],[41.02,43.81,"Hi, Anna, it's going great.","Salom, Anna, ishlar zo'r."],[44.56,46.11,"How's it going with you?","Siznikida-chi, ishlar qalay?"],[46.42,48.09,"Things are awesome.","Hammasi a'lo."],[48.46,51.39,"Pete, I want to work out.","Pete, men sport bilan shug'ullanmoqchiman."],[51.78,52.76,"Where is the gym?","Sport zali qayerda?"],[52.66,55.95,"The gym is across from the lounge.","Sport zali dam olish xonasining qarshisida."],[56.42,58.77,"It's next to the mail room.","U pochta xonasining yonida."],[59.36,61.43,"Go that way. Thanks, Pete.","U tomonga boring. — Rahmat, Pete."],[62.34,64.93,"No, Anna, not that way.","Yo'q, Anna, u tomonga emas."],[65.4,67.15,"Go that way.","U tomonga boring."],[94.16,99.19,"Oh, Pete, this is not the gym.","Oh, Pete, bu sport zali emas."],[99.66,103.17,"That's right, Anna, this is the mail room.","To'g'ri, Anna, bu pochta xonasi."],[104.08,107.77,"The gym is across from what?","Sport zali nimaning qarshisida?"],[107.86,110.52,"The gym is across from the lounge.","Sport zali dam olish xonasining qarshisida."],[110.42,114.27,"Across from the lounge.","Dam olish xonasining qarshisida."],[114.88,118.07,"Right, thanks.","Xo'p, rahmat."],[130.3,136.76,"Pete, this is not the gym.","Pete, bu sport zali emas."],[136.66,143.35,"The gym is across from the lounge.","Sport zali dam olish xonasining qarshisida."],[144.14,146.67,"It is behind the lobby.","U kirish zalining orqasida."],[147.98,149.69,"Right, right.","Ha, ha."],[150.64,151.67,"See you.","Ko'rishguncha."],[152.22,153.67,"See you, Anna.","Ko'rishguncha, Anna."],[186.36,189.11,"This is not the gym.","Bu sport zali emas."],[190.2,193.21,"This is a parking garage.","Bu avtoturargoh."],[195.34,196.29,"Hello?","Allo?"],[198.08,199.13,"Pete?","Pete?"],[210.42,213.59,"This is not a gym.","Bu sport zali emas."],[214.46,216.75,"This is a rooftop.","Bu tom."],[220.58,221.91,"Pete?","Pete?"],[228.1,229.43,"Pete?","Pete?"],[230.76,232.77,"I want to work out too.","Men ham sport bilan shug'ullanmoqchiman."],[233.7,234.75,"Join me.","Menga qo'shiling."],[235.38,236.43,"I'm good.","Kerak emas, rahmat."]]},{"n":7,"t":"What Are You Doing?","uz":"yangi ish","dur":299.5,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/6/69/690103ea-ce31-4425-97c1-65af2fff6ffd.mp4","poster":"https://gdb.voanews.com/690103ea-ce31-4425-97c1-65af2fff6ffd_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-7-what-are-you-doing-/5781372.html","s":[[18.64,20.37,"Hello everyone!","Hammaga salom!"],[20.72,23.19,"Today I start my new job!","Bugun yangi ishimni boshlayman!"],[24.44,27.49,"I meet my new boss and my co-workers.","Yangi boshlig'im va hamkasblarim bilan tanishaman."],[27.82,29.39,"I am excited!","Juda xursandman!"],[29.58,31.89,"But nervous!","Lekin hayajondaman!"],[33.88,34.99,"Here I go!","Qani, boshladik!"],[46.82,49.25,"Come in!","Kiring!"],[52.68,54.83,"Well, Anna.","Xo'sh, Anna."],[55.62,57.33,"Welcome. Thank you.","Xush kelibsiz. — Rahmat."],[57.96,60.93,"I am your boss, Katie Weaver.","Men sizning boshlig'ingiz, Keti Uiverman."],[61.12,63.25,"But please, call me Katie.","Lekin iltimos, meni Keti deb chaqiring."],[63.44,64.73,"Thank you, Ms. Weaver.","Rahmat, Uiver xonim."],[65.52,68.85,"Just Katie. Sure thing, Ms. Weaver.","Shunchaki Keti. — Albatta, Uiver xonim."],[69.74,72.21,"Okay then, are you excited?","Xo'p, xursandmisiz?"],[72.54,74.77,"Yes, I am excited.","Ha, juda xursandman."],[75.48,78.45,"So sorry, but I am busy.","Kechirasiz, lekin men bandman."],[78.9,80.85,"Please, meet your co-workers.","Iltimos, hamkasblaringiz bilan tanishing."],[81.18,84.49,"But remember, they are busy working.","Lekin esda tuting, ular ish bilan band."],[84.94,87.31,"Sure. Thanks, Ms. Weaver.","Albatta. Rahmat, Uiver xonim."],[95.4,97.69,"Hi there! I am Anna.","Salom! Men Annaman."],[98.0,99.99,"Hi, Anna. I am Anne.","Salom, Anna. Men Ennman."],[100.32,102.43,"Nice to meet you. What are you doing?","Tanishganimdan xursandman. Nima qilyapsiz?"],[102.46,105.35,"I am writing. You are writing.","Men yozyapman. — Siz yozyapsiz."],[105.34,107.33,"You are writing a lot.","Siz ko'p yozyapsiz."],[107.64,108.49,"Oh dear.","Voy."],[108.96,110.83,"No, no. I am sorry. That's okay.","Yo'q, yo'q. Kechirasiz. — Hechqisi yo'q."],[110.88,115.97,"That's okay. Really. Please, please, please, please stop.","Hechqisi yo'q. Rostdan. Iltimos, iltimos, to'xtang."],[118.74,119.57,"Sorry.","Kechirasiz."],[120.98,121.87,"Sorry.","Kechirasiz."],[145.74,153.06,"And people all around the world are waiting to hear news about the next president.","Butun dunyo odamlari keyingi prezident haqidagi yangiliklarni kutmoqda."],[152.96,155.31,"Jonathan, hi! Remember me?","Jonatan, salom! Meni eslaysizmi?"],[155.22,156.77,"I live in your building.","Men siz bilan bir binoda yashayman."],[157.08,159.18,"Oh, hi, Anna.","Oh, salom, Anna."],[159.08,160.61,"What are you doing?","Nima qilyapsiz?"],[160.7,162.93,"I am doing my show.","Men ko'rsatuvimni olib boryapman."],[163.48,164.81,"Oh, sorry.","Oh, kechirasiz."],[164.92,166.27,"Are you recording?","Yozib olyapsizmi?"],[166.58,169.9,"Yes, and now I have to record again.","Ha, endi qaytadan yozib olishim kerak."],[169.8,172.79,"Sorry. Have a good show.","Kechirasiz. Ko'rsatuvingiz yaxshi o'tsin."],[173.32,174.11,"Thank you.","Rahmat."],[174.48,175.27,"Sorry.","Kechirasiz."],[182.02,184.95,"The word of the day is social.","Kunning so'zi — «social»."],[185.84,187.53,"Social is an adjective.","«Social» — sifat."],[188.1,190.69,"I am Anna. Hi, I am Amelia.","Men Annaman. — Salom, men Ameliyaman."],[190.74,191.99,"Nice to meet you.","Tanishganimdan xursandman."],[192.64,193.87,"What are you doing?","Nima qilyapsiz?"],[194.3,195.67,"I am reading.","Men o'qiyapman."],[196.14,197.69,"Are you reading the news?","Yangiliklarni o'qiyapsizmi?"],[198.0,201.55,"Hi. No, I am reading for my show.","Salom. — Yo'q, ko'rsatuvim uchun o'qiyapman."],[204.04,205.89,"Can I read again?","Qaytadan o'qisam bo'ladimi?"],[206.9,207.59,"Sorry.","Kechirasiz."],[208.92,211.93,"This day is not going well.","Bugun kun yaxshi o'tmayapti."],[236.78,237.87,"Anna!","Anna!"],[238.66,239.59,"Hi.","Salom."],[240.04,241.19,"What are you doing?","Nima qilyapsiz?"],[242.0,244.53,"I am bothering people, Ms. Weaver.","Odamlarni bezovta qilyapman, Uiver xonim."],[246.3,249.09,"Let's go to my office and talk.","Kabinetimga yuring, gaplashamiz."],[250.02,252.23,"I'd like to talk with you, Ms. Weaver.","Siz bilan gaplashmoqchiman, Uiver xonim."],[252.96,253.93,"It's Katie.","Men Ketiman."],[254.44,257.75,"Right. Thanks, Ms. Weaver.","Ha. Rahmat, Uiver xonim."]]},{"n":8,"t":"Are You Busy?","uz":"uzr so'rash","dur":300.0,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/d/da/daba2df2-95ca-4c88-923f-0b967553558a.mp4","poster":"https://gdb.voanews.com/daba2df2-95ca-4c88-923f-0b967553558a_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-8-are-you-busy-/5781370.html","s":[[20.44,21.93,"Hello everyone.","Hammaga salom."],[22.08,24.31,"Here I am at my new job.","Mana, yangi ishimdaman."],[24.78,27.65,"Yesterday, at my first day of work.","Kecha, ishdagi birinchi kunimda."],[28.2,30.11,"I'm sorry. That's okay.","Kechirasiz. — Hechqisi yo'q."],[30.08,31.33,"That's okay. Really?","Hechqisi yo'q. — Rostdanmi?"],[32.08,32.45,"Yes.","Ha."],[32.96,35.29,"And now I have to record again.","Endi esa qaytadan yozib olishim kerak."],[35.7,38.68,"No. I'm reading for my show.","Yo'q. Men ko'rsatuvim uchun o'qiyapman."],[38.58,40.17,"Let's not talk about yesterday.","Kecha haqida gapirmaylik."],[40.44,42.25,"Today is a new day.","Bugun yangi kun."],[42.5,45.95,"Today, I want to apologize to my coworkers.","Bugun hamkasblarimdan uzr so'ramoqchiman."],[49.44,51.74,"Hi, Anne. Are you busy?","Salom, Enn. Bandmisiz?"],[51.64,53.99,"Hi Anna. Yes.","Salom, Anna. Ha."],[54.02,56.69,"At 10 a.m., I am writing.","Soat 10 da men yozaman."],[57.2,59.99,"Every day, I do my morning show.","Har kuni ertalabki ko'rsatuvimni olib boraman."],[60.52,61.37,"Sorry.","Kechirasiz."],[61.94,62.69,"Okay.","Xo'p."],[63.24,64.25,"See you later.","Keyinroq ko'rishamiz."],[65.2,65.87,"Maybe.","Balki."],[66.66,68.43,"Maybe I'll see you later.","Balki keyinroq ko'rishamiz."],[83.1,84.49,"Hi, Jonathan.","Salom, Jonatan."],[84.78,85.77,"Are you busy?","Bandmisiz?"],[85.98,87.39,"Yes. I'm busy.","Ha. Bandman."],[87.56,91.97,"When the studio light is on, I am recording my evening show.","Studiya chirog'i yonib tursa, men kechki ko'rsatuvimni yozib olayotgan bo'laman."],[92.1,94.35,"Right. Sorry about yesterday.","Xo'p. Kecha uchun kechirasiz."],[94.54,97.0,"No worries. May I see the studio?","Hechqisi yo'q. — Studiyani ko'rsam bo'ladimi?"],[96.9,98.55,"Maybe another time.","Balki boshqa safar."],[98.62,100.57,"Right now, I am busy.","Hozir bandman."],[101.16,102.87,"Sure. Okay.","Albatta. Xo'p."],[103.16,104.69,"Bye. Bye.","Xayr. — Xayr."],[136.64,138.21,"Hi, Amelia.","Salom, Ameliya."],[138.46,139.61,"Are you busy?","Bandmisiz?"],[139.74,143.99,"I'm a little busy. I want to say, I'm sorry.","Biroz bandman. — Uzr so'ramoqchiman."],[144.26,146.99,"For yesterday. It's okay, Anna.","Kecha uchun. — Hechqisi yo'q, Anna."],[147.2,148.65,"Well, I am sorry.","Baribir, kechirasiz."],[148.84,151.51,"It's okay, Anna. Come by this afternoon.","Hechqisi yo'q, Anna. Tushdan keyin kiring."],[151.94,152.71,"Okay.","Xo'p."],[181.56,182.53,"Anna.","Anna."],[183.32,184.77,"Yes, Ms. Weaver.","Ha, Uiver xonim."],[184.74,185.75,"Are you busy?","Bandmisiz?"],[185.74,188.03,"Yes, Ms. Weaver. I am busy.","Ha, Uiver xonim. Bandman."],[188.14,190.23,"My office. 5 p.m.","Kabinetimga. Soat 5 da."],[192.24,193.53,"5 p.m.","Soat 5 da."],[209.26,211.63,"Come in.","Kiring."],[212.3,213.67,"Surprise!","Kutilmagan sovg'a!"],[214.8,216.55,"A party!","Bayram!"],[216.72,217.51,"Awesome!","Zo'r!"],[218.44,220.83,"And I still have my job.","Va ishim ham joyida."],[222.04,223.27,"Until next time.","Keyingi safargacha."]]},{"n":9,"t":"Is It Cold?","uz":"ob-havo","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/a/a1/a134ed92-a3e1-4e8e-abed-0c5ac229acba.mp4","poster":"https://gdb.voanews.com/a134ed92-a3e1-4e8e-abed-0c5ac229acba_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-9-is-it-cold-/5781346.html","s":[[177.74,179.63,"Oh, hi, everyone.","Oh, hammaga salom."],[180.74,185.15,"Here in Washington, D.C., the weather changes often.","Vashingtonda ob-havo tez-tez o'zgaradi."],[185.32,191.55,"One day is cold and windy, but the next day is warm and sunny.","Bir kuni sovuq va shamolli, keyingi kuni esa iliq va quyoshli."],[192.94,195.77,"So, every day, I check the forecast.","Shuning uchun har kuni ob-havo ma'lumotini tekshiraman."],[198.04,201.03,"Hello, phone. What is today's temperature?","Salom, telefon. Bugun harorat qancha?"],[201.58,203.86,"Today, it is 18 degrees.","Bugun 18 daraja."],[203.76,205.19,"18 degrees?","18 daraja?"],[205.58,206.81,"That is cold.","Bu sovuq-ku."],[207.2,209.03,"18 degrees Celsius.","Selsiy bo'yicha 18 daraja."],[209.44,214.05,"Oh, Celsius. That is 65 degrees Fahrenheit.","Oh, Selsiy. Bu Farengeyt bo'yicha 65 daraja."],[214.24,216.51,"That's warm. Yes, Anna.","Bu iliq. — Ha, Anna."],[216.72,218.13,"It is warm.","Havo iliq."],[218.34,221.65,"Excuse me, phone. Is it windy today?","Kechirasiz, telefon. Bugun shamol bormi?"],[222.18,225.37,"No, it is not windy today.","Yo'q, bugun shamol yo'q."],[225.76,227.87,"Is it sunny today?","Bugun quyoshlimi?"],[228.18,231.07,"Yes, Anna. It is sunny.","Ha, Anna. Havo quyoshli."],[231.58,234.49,"Excuse me, phone. Yes, Anna.","Kechirasiz, telefon. — Ha, Anna."],[234.98,236.85,"Is it snowy today?","Bugun qor yog'adimi?"],[237.3,240.51,"No, Anna. It is not snowy.","Yo'q, Anna. Qor yog'maydi."],[241.36,242.39,"Thank you, phone.","Rahmat, telefon."],[243.26,246.33,"Today, the weather is warm and sunny.","Bugun havo iliq va quyoshli."],[246.58,249.47,"Great for seeing Washington, D.C.","Vashingtonni aylanish uchun juda yaxshi."],[251.08,254.57,"Phone. It is not warm and sunny.","Telefon. Havo iliq ham, quyoshli ham emas."],[254.84,259.02,"It is cold and windy and snowy.","Sovuq, shamolli va qor yog'yapti."],[258.92,263.89,"Anna, it is not cold, windy, or snowy.","Anna, havo sovuq ham, shamolli ham, qorli ham emas."],[264.14,270.49,"It is warm and sunny in Mexico City, Mexico.","Meksikada, Mexiko shahrida havo iliq va quyoshli."],[271.1,273.29,"Oh, I see.","Oh, tushundim."],[274.04,274.91,"Mexico.","Meksika."],[276.6,279.39,"Washington weather changes often.","Vashingtonda ob-havo tez-tez o'zgaradi."],[279.8,281.93,"Remember to check the forecast.","Ob-havo ma'lumotini tekshirishni unutmang."],[282.42,284.15,"The right forecast.","To'g'ri ma'lumotni."],[284.36,288.52,"Yes, Anna. Next time, remember to check the forecast.","Ha, Anna. Keyingi safar ob-havoni tekshirishni unutmang."],[288.42,290.09,"Thank you, phone.","Rahmat, telefon."],[290.48,291.35,"Goodbye, phone.","Xayr, telefon."],[292.54,294.29,"Until next time.","Keyingi safargacha."],[294.44,297.01,"Yes, until next time.","Ha, keyingi safargacha."]]},{"n":10,"t":"Come Over to My Place","uz":"yo'l ko'rsatish","dur":300.0,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/b/b3/b34664a8-fabc-4541-8be9-438f0d466626.mp4","poster":"https://gdb.voanews.com/b34664a8-fabc-4541-8be9-438f0d466626_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-10-come-over-to-my-place/5781340.html","s":[[206.64,207.73,"Hi.","Salom."],[208.34,210.85,"Today my friend Ashley is coming over.","Bugun dugonam Eshli mehmonga keladi."],[211.16,213.45,"I am showing her my new apartment.","Unga yangi kvartiramni ko'rsataman."],[215.38,217.07,"That's Ashley calling.","Bu Eshli qo'ng'iroq qilyapti."],[218.44,219.83,"Hi, Ashley.","Salom, Eshli."],[219.88,222.55,"Hi Anna. I am coming to your apartment.","Salom, Anna. Kvartirangga kelyapman."],[223.16,224.65,"Where is your apartment?","Kvartirang qayerda?"],[224.86,228.49,"My apartment is near the Columbia Heights Metro.","Kvartiram Kolumbiya Xayts metrosi yaqinida."],[228.92,231.39,"It is near the Columbia Heights Metro?","Kolumbiya Xayts metrosi yaqinidami?"],[231.56,234.21,"Yes. Exit the Metro and turn right.","Ha. Metrodan chiqib, o'ngga buril."],[234.48,237.23,"Then at the bus station turn left.","Keyin avtobus bekatida chapga buril."],[237.44,239.03,"Then walk straight ahead.","Keyin to'g'riga yur."],[239.52,240.17,"Okay.","Xo'p."],[240.54,243.82,"Exit Metro, turn right, turn left.","Metrodan chiqaman, o'ngga, keyin chapga buraman."],[243.72,245.13,"Then go straight ahead.","Keyin to'g'riga yuraman."],[245.6,249.45,"Yes. My apartment is near a coffee shop.","Ha. Kvartiram bir qahvaxona yaqinida."],[250.24,251.35,"See you soon.","Tez orada ko'rishamiz."],[254.2,255.71,"Hi, Ashley.","Salom, Eshli."],[255.66,257.99,"Hello, Anna. Which coffee shop?","Salom, Anna. Qaysi qahvaxona?"],[258.0,260.17,"There are three coffee shops.","Bu yerda uchta qahvaxona bor."],[260.52,265.15,"Okay. My apartment is across from a big department store.","Xo'p. Kvartiram katta univermag qarshisida."],[265.18,266.97,"A big department store?","Katta univermagmi?"],[267.12,269.07,"Ah. I see it.","A. Ko'ryapman."],[269.02,271.25,"Okay. Bye, Ashley. See you soon.","Xo'p. Xayr, Eshli. Tez orada ko'rishamiz."],[271.58,273.39,"Okay. See you soon.","Xo'p. Tez orada ko'rishamiz."],[274.76,275.71,"Okay.","Xo'p."],[279.26,280.61,"Ashley!","Eshli!"],[281.0,281.57,"Ashley!","Eshli!"],[282.2,283.03,"Ashley!","Eshli!"],[283.38,284.61,"Over here!","Men bu yerdaman!"],[286.24,286.87,"Donna!","Donna!"],[287.22,288.87,"Hi! Oh!","Salom! Oh!"],[291.02,293.87,"I love having my friends over.","Do'stlarimni mehmonga chaqirishni yaxshi ko'raman."],[294.66,295.52,"Come on!","Qani, yuringlar!"]]},{"n":11,"t":"This Is My Neighborhood","uz":"mahalla, kundalik ishlar","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/1/12/1249bcfa-481d-498d-a387-a577c59adba9.mp4","poster":"https://gdb.voanews.com/1249bcfa-481d-498d-a387-a577c59adba9_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-11-this-is-my-neighborhood/5781342.html","s":[[174.36,175.47,"Hello!","Salom!"],[176.04,178.69,"D.C. is a city for walking.","Vashington — piyoda yurish uchun shahar."],[178.94,182.65,"In our neighborhood, I can do all my errands.","Mahallamizda barcha yumushlarimni qila olaman."],[183.12,188.67,"Marsha, before we get ice cream, I need to return three books to the library.","Marsha, muzqaymoq olishdan oldin kutubxonaga uchta kitob qaytarishim kerak."],[188.98,190.34,"Where is the library?","Kutubxona qayerda?"],[190.24,193.11,"It is on this street.","Shu ko'chada."],[193.46,195.33,"On the corner. Awesome!","Burchakda. — Zo'r!"],[195.34,196.13,"Let's go!","Ketdik!"],[198.66,201.51,"Marsha, I can return the books here.","Marsha, kitoblarni shu yerga qaytarsam bo'ladi."],[204.5,207.43,"Anna, what are those in the books?","Anna, kitoblar orasidagi nima?"],[208.38,214.21,"Marsha, these are letters to my family and friends back home.","Marsha, bular yurtimdagi oilam va do'stlarimga yozgan xatlarim."],[214.36,218.15,"Four letters. Is there a post office near here?","To'rtta xat. Bu yaqin atrofda pochta bormi?"],[218.66,220.41,"Um, no.","Hmm, yo'q."],[220.42,222.63,"The post office is far from here.","Pochta bu yerdan uzoqda."],[222.76,225.69,"But there is a mailbox across from the store.","Lekin do'kon qarshisida pochta qutisi bor."],[225.9,227.41,"Awesome! Let's go!","Zo'r! Ketdik!"],[234.18,237.09,"Marsha, now I need to buy stamps.","Marsha, endi marka sotib olishim kerak."],[237.08,238.31,"Do you have cash?","Naqd pulingiz bormi?"],[238.5,239.21,"No.","Yo'q."],[239.62,241.29,"Is there a bank near here?","Bu yaqin atrofda bank bormi?"],[241.54,243.51,"There is a bank behind you.","Orqangizda bank bor."],[244.0,247.59,"Thanks, Marsha. You know our neighborhood so well.","Rahmat, Marsha. Mahallamizni juda yaxshi bilasiz."],[252.92,254.93,"Now I have cash.","Endi naqd pulim bor."],[255.04,256.45,"I can buy stamps.","Marka sotib olsam bo'ladi."],[257.02,259.35,"That store sells stamps.","Anavi do'konda marka sotiladi."],[259.4,260.49,"Wait here.","Shu yerda kuting."],[261.68,263.51,"I have stamps.","Markalarni oldim."],[263.52,265.25,"Wow! You're fast!","Voy! Juda tezsiz!"],[265.92,267.25,"Thank you.","Rahmat."],[267.26,274.69,"Thank you, letters, for sending my words, my love, to my family and friends back home.","Rahmat, xatlarim, so'zlarimni, mehrimni yurtimdagi oilam va do'stlarimga yetkazganingiz uchun."],[278.92,281.09,"Do you have more cash?","Yana naqd pulingiz bormi?"],[281.76,282.53,"I do.","Bor."],[284.04,285.03,"Ice cream!","Muzqaymoq!"],[287.64,289.95,"I love my new neighborhood.","Yangi mahallamni yaxshi ko'raman."],[290.04,292.39,"Everything is near our apartment.","Hamma narsa kvartiramizga yaqin."],[292.64,296.47,"Even hair salons and ice cream.","Hatto sartaroshxonalar va muzqaymoq ham."],[296.92,298.19,"Until next time!","Keyingi safargacha!"]]},{"n":12,"t":"Meet My Family","uz":"oila","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/b/b7/b7fedcc7-4bb0-4cf7-b596-ccd2a5e03041.mp4","poster":"https://gdb.voanews.com/b7fedcc7-4bb0-4cf7-b596-ccd2a5e03041_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-12-meet-my-family/5780976.html","s":[[16.7,18.05,"Hello.","Salom."],[19.22,22.89,"Washington, D.C. has many beautiful parks.","Vashingtonda chiroyli bog'lar ko'p."],[24.18,30.59,"In fact, this park reminds me of my home, very far away.","Aslida bu bog' menga juda uzoqdagi uyimni eslatadi."],[33.96,37.05,"Anna, here's your coffee.","Anna, mana qahvangiz."],[37.6,39.77,"Thanks, Marsha. What's wrong?","Rahmat, Marsha. — Nima bo'ldi?"],[41.12,43.35,"I'm thinking about my family.","Oilam haqida o'ylayapman."],[44.04,46.77,"I'm feeling homesick.","Uyimni sog'indim."],[47.66,49.23,"You want to talk about it?","Bu haqda gaplashishni xohlaysizmi?"],[49.7,50.59,"Sure.","Albatta."],[50.98,52.63,"I have some photos.","Menda bir nechta suratlar bor."],[53.58,56.65,"Yes, yes you do.","Ha, ha, bor."],[57.52,58.93,"Photos really help.","Suratlar rostdan yordam beradi."],[61.44,65.37,"This is my mother and this is my father.","Bu mening onam, bu esa otam."],[65.64,67.22,"They are rodeo clowns.","Ular rodeo masxarabozlari."],[68.9,72.29,"What do rodeo clowns do?","Rodeo masxarabozlari nima qiladi?"],[72.5,75.25,"They make jokes at a rodeo.","Ular rodeoda hazil qilishadi."],[75.42,76.45,"People laugh.","Odamlar kuladi."],[109.4,111.65,"That's very different.","Bu juda boshqacha."],[112.66,114.43,"Who is that woman in the picture?","Suratdagi ayol kim?"],[114.88,117.31,"That is my Aunt Lavender.","Bu mening Lavender xolam."],[117.5,119.67,"She is my mom's sister.","U onamning singlisi."],[120.52,123.59,"She loves gardening and makes spoons.","U bog'dorchilikni yaxshi ko'radi va qoshiq yasaydi."],[125.36,127.27,"She makes spoons?","Qoshiq yasaydimi?"],[127.62,128.61,"Of course.","Albatta."],[129.08,132.11,"That too is very different.","Bu ham juda boshqacha."],[132.54,134.5,"Oh, this is my Uncle John.","Oh, bu mening Jon amakim."],[134.4,136.81,"He is my father's brother.","U otamning akasi."],[137.7,140.61,"What does Uncle John do?","Jon amakingiz nima ish qiladi?"],[140.6,143.43,"He's a chicken farmer and makes guitars.","U tovuq fermeri va gitara yasaydi."],[144.5,148.27,"He's awesome and I'm his favorite niece.","U zo'r, men esa uning eng sevimli jiyaniman."],[148.8,149.85,"Who are they?","Ular kim?"],[150.02,151.67,"They are my cousins.","Ular mening amakivachchalarim."],[152.02,155.43,"They are my Uncle John's daughter and son.","Ular Jon amakimning qizi va o'g'li."],[189.38,191.33,"What do they do?","Ular nima ish qiladi?"],[191.76,194.43,"They raise sheep and make sweaters.","Ular qo'y boqishadi va sviter to'qishadi."],[194.68,196.97,"Yeah, that's not a surprise.","Ha, bu ajablanarli emas."],[198.8,201.37,"Thanks for showing me your family photos.","Oilaviy suratlaringizni ko'rsatganingiz uchun rahmat."],[201.66,205.35,"Your family is very different.","Oilangiz juda boshqacha."],[205.46,206.95,"I do feel better.","Rostdan o'zimni yaxshi his qilyapman."],[207.2,208.45,"Thanks for listening.","Tinglaganingiz uchun rahmat."],[208.8,210.93,"I have many more photos.","Menda yana ko'p suratlar bor."],[213.56,216.07,"Yeah, yeah you do.","Ha, ha, bor."],[217.18,223.09,"Washington, D.C. is my new home, but I like remembering my old home too.","Vashington — mening yangi uyim, lekin eski uyimni eslashni ham yaxshi ko'raman."],[228.72,231.65,"This is a family tree.","Bu shajara."],[233.06,235.63,"Anna tells Marsha about her parents.","Anna Marshaga ota-onasi haqida gapirib beradi."],[236.78,240.12,"Her mother and father are rodeo clowns.","Uning onasi va otasi rodeo masxarabozlari."],[240.02,244.67,"Her father's parents are from Italy.","Otasining ota-onasi Italiyadan."],[246.16,248.67,"These grandparents speak Italian.","Bu buvi-buvalar italyancha gapirishadi."],[251.12,254.37,"Anna's mother's parents live in California.","Annaning onasining ota-onasi Kaliforniyada yashaydi."],[255.7,259.45,"These grandparents have a farm and raise horses.","Bu buvi-buvalarning fermasi bor, ular ot boqishadi."],[261.06,264.59,"Anna's mother's sister is Aunt Lavender.","Annaning onasining singlisi — Lavender xola."],[265.42,266.95,"She loves gardening.","U bog'dorchilikni yaxshi ko'radi."],[268.84,271.05,"Anna's father has a brother.","Annaning otasining akasi bor."],[271.74,273.15,"His name is John.","Uning ismi Jon."],[274.56,276.39,"Uncle John makes guitars.","Jon amaki gitara yasaydi."],[278.16,280.71,"Uncle John has a daughter and a son.","Jon amakining bir qizi va bir o'g'li bor."],[281.56,283.27,"They are Anna's cousins.","Ular Annaning amakivachchalari."],[284.28,285.53,"They raise sheep.","Ular qo'y boqishadi."],[287.46,289.99,"Anna's brother has two children.","Annaning akasining ikki farzandi bor."],[290.66,293.49,"They are Anna's niece and nephew.","Ular Annaning jiyanlari (qiz va o'g'il)."]]},{"n":13,"t":"Happy Birthday, William Shakespeare!","uz":"odatiy va g'ayrioddiy","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/7/73/73103ed5-8133-4a1a-9219-cfef86973f25.mp4","poster":"https://gdb.voanews.com/73103ed5-8133-4a1a-9219-cfef86973f25_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-13-happy-birthday-shakespeare-/5780971.html","s":[[16.76,17.95,"Hello!","Salom!"],[18.36,23.65,"In Washington, D.C., there are many things to do on a Sunday afternoon.","Vashingtonda yakshanba kuni tushdan keyin qiladigan ishlar ko'p."],[24.26,29.63,"I like to exercise, I like to shop, I like to garden.","Men sport bilan shug'ullanishni, xarid qilishni, bog'da ishlashni yaxshi ko'raman."],[30.42,33.21,"But today, I feel bored.","Lekin bugun zerikyapman."],[33.9,40.31,"When I feel bored, I always look for something unusual to do.","Zerikkanimda doim g'ayrioddiy biror ish qidiraman."],[42.38,44.29,"I hear music.","Musiqa eshityapman."],[45.3,46.69,"Let's go see.","Borib ko'raylik."],[76.1,79.33,"What is going on here?","Bu yerda nima bo'lyapti?"],[79.58,82.87,"It's a big birthday party for the writer, William Shakespeare.","Bu yozuvchi Uilyam Shekspir uchun katta tug'ilgan kun bazmi."],[82.78,85.63,"This is a party for William Shakespeare?","Bu Uilyam Shekspir uchun bazmmi?"],[85.66,87.11,"Yes! Awesome!","Ha! — Zo'r!"],[101.2,103.87,"This is a drum band.","Bu barabanchilar guruhi."],[104.76,110.4,"I never listened to a drum band, but today I am listening to a drum band.","Hech qachon barabanchilar guruhini tinglamaganman, lekin bugun tinglayapman."],[110.3,112.81,"Because it's Shakespeare's birthday.","Chunki bugun Shekspirning tug'ilgan kuni."],[126.42,129.95,"This is a puppet show.","Bu qo'g'irchoq teatri."],[130.84,139.71,"I never watch puppet shows, but today I am watching a puppet show because it's Shakespeare's birthday.","Hech qachon qo'g'irchoq teatri ko'rmayman, lekin bugun ko'ryapman, chunki bugun Shekspirning tug'ilgan kuni."],[192.04,195.51,"My clothes are usual.","Mening kiyimim odatiy."],[196.16,198.95,"His clothes are unusual.","Uning kiyimi g'ayrioddiy."],[238.52,247.71,"In Washington, D.C., seeing a politician or even the President is usual.","Vashingtonda siyosatchini, hatto Prezidentni ko'rish odatiy hol."],[248.12,252.79,"Seeing the Queen of England is very unusual.","Angliya qirolichasini ko'rish esa juda g'ayrioddiy."],[253.42,254.55,"Your Majesty.","Oliy hazratlari."],[258.46,261.19,"This is sword fighting.","Bu qilichbozlik."],[263.06,270.97,"I never sword fight, but today I am sword fighting because it's Shakespeare's birthday.","Hech qachon qilichbozlik qilmayman, lekin bugun qilyapman, chunki bugun Shekspirning tug'ilgan kuni."],[275.34,280.35,"There are many things to do in Washington, D.C.","Vashingtonda qiladigan ishlar ko'p."],[282.22,284.85,"Some usual, some unusual.","Ba'zilari odatiy, ba'zilari g'ayrioddiy."],[285.36,291.81,"Today, I am not bored because it is William Shakespeare's birthday.","Bugun zerikmayapman, chunki bugun Uilyam Shekspirning tug'ilgan kuni."]]},{"n":14,"t":"How About This?","uz":"kiyim","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/3/3d/3d8d63a8-2984-4469-9737-d34b0d519506.mp4","poster":"https://gdb.voanews.com/3d8d63a8-2984-4469-9737-d34b0d519506_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-14-how-about-this-/5780974.html","s":[[16.16,17.69,"Hi there.","Salom."],[17.82,21.87,"In Washington, D.C., people do many things in the evening.","Vashingtonda odamlar kechqurun ko'p narsa qilishadi."],[22.32,23.86,"They go listen to music.","Musiqa tinglashga borishadi."],[23.76,26.33,"They eat at a restaurant.","Restoranda ovqatlanishadi."],[26.6,28.13,"They go to the theater.","Teatrga borishadi."],[28.74,32.03,"Tonight, I am going to the theater with my friends.","Bugun kechqurun do'stlarim bilan teatrga boryapman."],[32.9,35.35,"But I don't know what clothes to wear.","Lekin qanday kiyim kiyishni bilmayman."],[36.06,38.03,"Maybe this magazine can help.","Balki bu jurnal yordam berar."],[39.5,41.27,"Her clothes are beautiful.","Uning kiyimlari chiroyli."],[41.8,45.02,"I really want a friend like her to help me.","Menga ham shunday dugona yordam berishini juda xohlayman."],[44.92,48.65,"Who are you?","Siz kimsiz?"],[48.88,50.91,"I am Jeannie.","Men Jinniman."],[51.34,53.47,"You want help?","Yordam kerakmi?"],[53.54,58.13,"I am here to help you find the right clothes.","Men sizga to'g'ri kiyim topishga yordam berish uchun keldim."],[58.54,59.43,"Awesome!","Zo'r!"],[59.8,62.13,"How about jeans and a t-shirt?","Jinsi shim va futbolka-chi?"],[62.4,63.47,"No!","Yo'q!"],[64.02,67.17,"Jeans and a t-shirt are too casual.","Jinsi shim va futbolka juda oddiy."],[67.38,70.17,"How about something more formal?","Rasmiyroq narsa-chi?"],[70.44,71.33,"Sure.","Albatta."],[74.92,76.23,"Wow!","Voy!"],[76.4,82.27,"Jeannie, this dress is beautiful, but it's not the right size.","Jinni, bu ko'ylak chiroyli, lekin o'lchami to'g'ri emas."],[82.44,84.17,"It's too small.","U juda kichik."],[84.68,91.11,"Yes, it is too small, but green looks great on you.","Ha, juda kichik, lekin yashil rang sizga juda yarashadi."],[91.4,94.63,"Thanks. Take off the green dress.","Rahmat. — Yashil ko'ylakni yeching."],[94.98,100.01,"Let's try a green shirt and a skirt.","Yashil ko'ylak va yubkani kiyib ko'raylik."],[132.34,138.03,"Oh, Jeannie, this green shirt is too large.","Oh, Jinni, bu yashil ko'ylak juda katta."],[138.64,142.77,"And this orange skirt is too orange.","Bu to'q sariq yubka esa haddan tashqari to'q sariq."],[143.38,147.71,"Yes, the right size for you is medium.","Ha, sizga to'g'ri o'lcham — o'rtacha (medium)."],[148.4,150.35,"Let's try again.","Yana urinib ko'raylik."],[154.74,158.29,"Oh, I don't like this outfit.","Oh, bu kiyim menga yoqmayapti."],[158.44,161.43,"No, that does not match.","Yo'q, bular bir-biriga mos emas."],[161.96,162.71,"Nothing.","Hech narsa."],[166.48,168.57,"These clothes are formal.","Bu kiyimlar rasmiy."],[168.86,172.33,"A suit jacket, a dress shirt, and a tie.","Kostyum, ko'ylak va galstuk."],[172.34,173.67,"They look great.","Ular zo'r ko'rinadi."],[173.98,176.21,"Those clothes look great.","Bu kiyimlar zo'r ko'rinadi."],[176.38,180.41,"For a man. Something is wrong.","Erkak uchun. — Nimadir noto'g'ri."],[181.26,182.43,"Let me see.","Ko'ray-chi."],[185.16,186.51,"There. Now try.","Mana. Endi kiyib ko'ring."],[191.35,192.91,"Oh, thanks.","Oh, rahmat."],[193.38,196.58,"Now these clothes look great on you.","Endi bu kiyimlar sizga juda yarashdi."],[196.48,197.61,"They do.","Ha, yarashdi."],[198.0,202.17,"Um, Jeannie, can you put on a gold belt?","Hmm, Jinni, oltin rang kamar taqib ko'rasizmi?"],[202.98,203.81,"Sure.","Albatta."],[205.82,207.75,"That looks great.","Juda chiroyli."],[208.3,210.57,"Can you put on a jacket?","Kurtka kiyib ko'rasizmi?"],[211.04,212.13,"Why not?","Nega yo'q?"],[213.44,215.83,"I love the jacket.","Kurtka juda yoqdi."],[215.92,217.95,"How about a hat?","Shlyapa-chi?"],[218.6,219.93,"Why not?","Nega yo'q?"],[255.46,256.39,"Mmm.","Hmm."],[257.16,258.43,"Take off the hat.","Shlyapani yeching."],[262.36,263.85,"That's better.","Mana, yaxshiroq."],[264.06,267.05,"Jeannie, these clothes look and feel great.","Jinni, bu kiyimlar chiroyli va qulay."],[267.26,268.57,"Let's go to the theater.","Teatrga ketdik."],[268.86,272.83,"Sorry, Anna. I have to help other friends.","Kechirasiz, Anna. Boshqa dugonalarimga ham yordam berishim kerak."],[273.16,276.25,"Go to the magazine if you want me to help again.","Yana yordam kerak bo'lsa, jurnalga murojaat qiling."],[276.5,278.69,"Thanks, Jeannie. Sure thing.","Rahmat, Jinni. — Arzimaydi."],[278.68,280.17,"Goodbye. Goodbye.","Xayr. — Xayr."],[282.6,288.59,"There are many places in D.C. to go for a great evening out.","Vashingtonda kechqurun yaxshi dam olish uchun joylar ko'p."],[289.38,293.85,"And it's nice to have a friend to help me look my best.","Eng yaxshi ko'rinishimga yordam beradigan dugonam borligi esa yoqimli."],[294.8,296.45,"Until next time, bye!","Keyingi safargacha, xayr!"]]},{"n":15,"t":"I Love People Watching!","uz":"odamlarning tashqi ko'rinishi","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/b/b0/b07eac5a-cc3a-4f3e-821c-ecae337b5415.mp4","poster":"https://gdb.voanews.com/b07eac5a-cc3a-4f3e-821c-ecae337b5415_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-15-i-love-people-watching-/5780968.html","s":[[24.32,29.88,"Hello, people from all over the world come to Washington, D.C.","Salom, Vashingtonga butun dunyodan odamlar keladi."],[29.78,33.99,"When I'm at work, I love eating lunch outside.","Ishdaligimda tushlikni tashqarida qilishni yaxshi ko'raman."],[34.22,37.07,"I like to watch people walking by.","O'tib ketayotgan odamlarni kuzatishni yaxshi ko'raman."],[37.14,39.29,"They all look very different.","Ularning hammasi juda boshqacha ko'rinadi."],[39.42,42.59,"Today, my friend Ashley is eating lunch with me.","Bugun dugonam Eshli men bilan tushlik qilyapti."],[43.24,46.71,"Ashley, today the weather is beautiful, isn't it?","Eshli, bugun havo juda chiroyli, shunday emasmi?"],[46.68,48.53,"Yes, it is.","Ha, shunday."],[50.8,53.69,"Oh, we have to return to work.","Oh, ishga qaytishimiz kerak."],[53.96,55.87,"No, we have time.","Yo'q, vaqtimiz bor."],[55.96,58.05,"Let's people watch a little more.","Keling, odamlarni yana bir oz kuzataylik."],[58.68,59.85,"Okay.","Xo'p."],[96.88,101.55,"Oh, I know her.","Oh, men uni taniyman."],[101.56,103.07,"She works in my office.","U mening ishxonamda ishlaydi."],[103.36,105.69,"Keyana, hi. Come and join us.","Keyana, salom. Bizga qo'shiling."],[105.98,107.34,"Hi, Anna. How are you?","Salom, Anna. Qalaysiz?"],[107.24,110.47,"I'm doing great. Keyana, this is my friend Ashley.","Ajoyib. Keyana, bu dugonam Eshli."],[110.58,117.95,"Hi, Ashley. We need to return to work, but the weather is beautiful, and people watching is fun.","Salom, Eshli. — Ishga qaytishimiz kerak, lekin havo chiroyli, odamlarni kuzatish esa qiziq."],[118.12,119.73,"I love people watching, too.","Men ham odamlarni kuzatishni yaxshi ko'raman."],[119.84,122.15,"Well, have a seat.","Unda, o'tiring."],[123.3,127.47,"It is fun to see how people are different or the same.","Odamlar qanday farq qilishini yoki o'xshashligini ko'rish qiziq."],[128.3,134.09,"It is. For example, Anna, you are tall, but Ashley and I are short.","Ha. Masalan, Anna, siz baland bo'yliksiz, Eshli bilan men esa past bo'yliqmiz."],[139.04,143.01,"And Keyana, you and Ashley have brown eyes.","Keyana, siz va Eshlining ko'zlaringiz jigarrang."],[143.14,144.61,"I have blue eyes.","Mening ko'zlarim ko'k."],[144.92,148.23,"You two have light skin and I have dark skin.","Ikkalangizning teringiz och rangli, meniki esa to'q."],[149.86,151.61,"Ashley, you have straight hair.","Eshli, sizning sochingiz tekis."],[151.9,154.21,"Keyana and I have curly hair.","Keyana va mening sochimiz jingalak."],[154.14,156.45,"You have very curly hair, Anna.","Anna, sizning sochingiz juda jingalak."],[157.16,158.93,"I need to return to work.","Men ishga qaytishim kerak."],[159.06,161.75,"See you, Anna. Nice to meet you, Ashley.","Ko'rishguncha, Anna. Tanishganimdan xursandman, Eshli."],[161.84,162.87,"Bye, Keyana.","Xayr, Keyana."],[165.64,168.29,"Anna, I have to go, too.","Anna, men ham ketishim kerak."],[168.56,170.08,"Are you returning to work?","Ishga qaytyapsizmi?"],[169.98,175.59,"I still have time, and the sun feels so good.","Hali vaqtim bor, quyosh ham juda yoqimli."],[179.7,183.79,"Anna, what does your boss look like?","Anna, boshlig'ing qanday ko'rinishda?"],[183.86,185.49,"She is short.","U past bo'yli."],[185.78,187.89,"She has straight, light hair.","Sochi tekis va och rangda."],[188.22,189.59,"Does she wear glasses?","Ko'zoynak taqadimi?"],[189.86,191.67,"Yes. Yes, she does.","Ha. Ha, taqadi."],[191.7,194.55,"Is she wearing a blue sweater today?","Bugun ko'k sviter kiyganmi?"],[232.24,234.03,"How do you know that?","Buni qayerdan bilasan?"],[234.46,236.45,"She's coming this way.","U shu tomonga kelyapti."],[236.44,238.59,"Oh, no. Hide me.","Voy, yo'q. Meni yashir."],[242.1,243.41,"Bye, Anna.","Xayr, Anna."],[243.78,245.85,"Call me later. Bye, Ashley.","Keyin qo'ng'iroq qil. — Xayr, Eshli."],[245.84,246.89,"Talk to you later.","Keyin gaplashamiz."],[251.1,253.21,"Anna, is that you?","Anna, bu sizmisiz?"],[253.6,256.07,"Ms. Weaver, hi.","Uiver xonim, salom."],[256.48,258.42,"What are you doing behind that bench?","O'sha o'rindiq orqasida nima qilyapsiz?"],[258.32,262.03,"I am looking for my stick.","Men... tayoqchamni qidiryapman."],[262.44,263.83,"Here it is.","Mana u."],[264.1,265.85,"I am people-watching.","Men odamlarni kuzatyapman."],[266.54,269.31,"Oh, but it's time to return to work.","Oh, lekin ishga qaytish vaqti bo'ldi."],[269.62,271.05,"No need to hurry.","Shoshilish shart emas."],[271.4,273.49,"I love people-watching, too.","Men ham odamlarni kuzatishni yaxshi ko'raman."],[273.7,275.43,"Let's sit. Sure.","O'tiraylik. — Albatta."],[282.84,285.4,"It's a beautiful day, isn't it?","Chiroyli kun, shunday emasmi?"],[285.3,288.07,"Yes. Yes, it is, Ms. Weaver.","Ha. Ha, shunday, Uiver xonim."],[289.26,291.91,"People-watching in D.C. is fun.","Vashingtonda odamlarni kuzatish qiziq."],[292.14,294.21,"It makes me forget the time.","Vaqtni unuttirib qo'yadi."],[294.46,295.71,"Until next time.","Keyingi safargacha."]]}],"src":"VOA Learning English — Let's Learn English, Level 1 (learningenglish.voanews.com). Vaqtlar: Whisper (small.en). Tarjima: qo'lda."}