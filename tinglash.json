{"lessons":[{"n":1,"t":"Welcome!","uz":"tanishuv","dur":300.4,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/5/5f/5f00c78a-0f84-41e6-949d-bd808bcadf50.mp4","poster":"https://gdb.voanews.com/5f00c78a-0f84-41e6-949d-bd808bcadf50_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-one/3111026.html","s":[[200.78,202.63,"Hi, are you Anna?","Salom, siz Annamisiz?"],[202.7,204.53,"Yes. Hi there. Are you Pete?","Ha. Salom. Siz Petemisiz?"],[204.66,206.62,"I am Pete. Nice to meet you.","Men Peteman. Tanishganimdan xursandman."],[206.52,210.23,"Oh, let's try that again.","Oh, keling, qaytadan urinib ko'raylik."],[211.0,213.13,"I'm Anna. Nice to meet you.","Men Annaman. Tanishganimdan xursandman."],[213.16,214.09,"I'm Pete.","Men Peteman."],[214.66,217.25,"Anna, is that A-N-A?","Anna — bu A-N-A mi?"],[217.26,219.83,"No, A-N-N-A.","Yo'q, A-N-N-A."],[220.16,222.15,"Well, Anna with two n's.","Xo'p, ikkita «n» bilan Anna."],[222.66,226.59,"Welcome to 1400 Irving Street.","Irving ko'chasi, 1400-uyga xush kelibsiz."],[226.9,228.55,"My new apartment.","Mening yangi kvartiram."],[229.04,229.67,"Yes.","Ha."]]},{"n":2,"t":"Hello, I'm Anna!","uz":"tanishtirish","dur":300.4,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/4/42/4298a2ba-d665-4b1c-aaa1-502bbcb9b88d.mp4","poster":"https://gdb.voanews.com/4298a2ba-d665-4b1c-aaa1-502bbcb9b88d_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-2-hello/3113733.html","s":[[169.96,171.05,"Hi. Hey, Pete.","Salom. — Salom, Pete."],[171.42,172.49,"Who's your friend?","Do'stingiz kim?"],[173.0,175.27,"She is Anna. She is new to D.C.","Bu Anna. U Vashingtonga (D.C.) yangi kelgan."],[175.56,176.6,"Where are you from?","Qayerdansiz?"],[176.5,178.99,"I am from a small town.","Men kichik bir shaharchadanman."],[180.0,181.99,"Welcome to D.C. Thank you.","Vashingtonga xush kelibsiz. — Rahmat."],[182.02,182.93,"I'm Jonathan.","Men Jonatanman."],[183.4,185.09,"I'm in apartment B4.","Men B4-kvartiradaman."],[185.64,187.73,"I am in apartment C2.","Men C2-kvartiradaman."],[188.02,189.81,"Marsha is my roommate.","Marsha mening xonadoshim."],[190.38,191.73,"I know Marsha.","Men Marshani taniyman."],[191.9,193.09,"She is nice.","U yoqimli."],[193.88,196.77,"And I am in apartment D7.","Men esa D7-kvartiradaman."],[197.52,199.21,"I have to go now.","Men hozir ketishim kerak."],[199.2,199.93,"Oh.","O."],[200.42,202.47,"Remember to call Marsha at work.","Marshaga ishiga qo'ng'iroq qilishni unutmang."],[202.48,203.9,"Tell her you're here.","Unga shu yerdaligingizni ayting."],[203.8,205.14,"Right. Thanks, Pete.","Xo'p. Rahmat, Pete."],[205.04,207.04,"Nice to meet you.","Tanishganimdan xursandman."],[206.94,208.35,"You too. Bye.","Men ham. Xayr."],[210.58,213.81,"Apartment C2, here I come.","C2-kvartira, men kelyapman."]]},{"n":3,"t":"I'm Here!","uz":"uzr so'rash, telefonda","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/0/02/027f8fdd-e9b0-409c-8618-45be49fcefe8.mp4","poster":"https://gdb.voanews.com/027f8fdd-e9b0-409c-8618-45be49fcefe8_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-3-i-am-here/3126527.html","s":[[187.41,190.31,"I am in my new apartment.","Men yangi kvartiramdaman."],[190.66,191.37,"Great.","Zo'r."],[191.8,193.37,"I live with Marsha.","Men Marsha bilan yashayman."],[193.56,195.25,"We're roommates.","Biz xonadoshmiz."],[196.18,198.39,"I want to cook dinner.","Men kechki ovqat pishirmoqchiman."],[204.04,209.25,"Oh, is there a supermarket near here?","Oh, shu yaqin atrofda supermarket bormi?"],[210.36,211.37,"Marsha knows.","Marsha biladi."],[214.06,219.49,"Marsha's work number is 555-8986.","Marshaning ish raqami 555-8986."],[222.58,223.75,"Hello.","Allo."],[224.16,225.79,"Is this Marsha?","Bu Marshami?"],[225.74,227.89,"It is Anna. I am sorry.","Bu Anna. — Kechirasiz."],[227.84,229.31,"You have the wrong number.","Siz noto'g'ri raqam terdingiz."],[229.66,233.53,"Is this 555-8986?","Bu 555-8986 mi?"],[234.26,238.17,"No. This is 555-8689.","Yo'q. Bu 555-8689."],[239.42,241.42,"Oh, excuse me.","Oh, kechirasiz."],[241.32,242.39,"Okay. Bye.","Xo'p. Xayr."],[243.5,245.41,"One more time.","Yana bir marta."],[250.76,252.39,"Please be Marsha.","Iltimos, Marsha bo'lsin."],[255.12,257.4,"Hello. This is Marsha.","Allo. Bu Marsha."],[257.3,260.45,"Yes, Marsha. I want to cook dinner.","Ha, Marsha. Men kechki ovqat pishirmoqchiman."],[260.64,261.57,"Excuse me?","Nima dedingiz?"],[261.86,263.35,"Anna, is that you?","Anna, bu sizmisiz?"],[263.3,264.99,"Oh, yes. I am here.","Oh, ha. Men shu yerdaman."],[265.18,267.07,"Good. You are there.","Yaxshi. Siz u yerdasiz."],[267.22,270.03,"I want to find a supermarket.","Men supermarket topmoqchiman."],[270.1,271.49,"Oh, okay.","Oh, xo'p."],[271.68,276.41,"The supermarket is at 1500 Irving Street.","Supermarket Irving ko'chasi, 1500-uyda."],[276.52,278.35,"It is near the apartment.","U kvartiraga yaqin."],[278.54,279.13,"Great.","Zo'r."],[279.74,281.61,"Goodbye. Goodbye, Anna.","Xayr. — Xayr, Anna."],[283.56,288.07,"There is a big supermarket on our street.","Ko'chamizda katta supermarket bor."],[288.04,291.89,"And Marsha says, I am a good cook.","Marsha esa men yaxshi oshpazman deydi."],[293.0,295.09,"Until next time, bye.","Keyingi safargacha, xayr."]]},{"n":4,"t":"What Is It?","uz":"kundalik narsalar","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/c/c8/c829a13b-9764-4b89-ad70-1edbdc3d8013.mp4","poster":"https://gdb.voanews.com/c829a13b-9764-4b89-ad70-1edbdc3d8013_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-4/3168920.html","s":[[174.16,183.87,"Pete, hi.","Pete, salom."],[183.82,185.41,"Hi. We are here.","Salom. Biz keldik."],[185.7,187.23,"Hi, Anna. Hi, Marsha.","Salom, Anna. Salom, Marsha."],[187.32,187.89,"Hi.","Salom."],[188.48,189.93,"How are you two?","Ikkalangiz qalaysiz?"],[189.92,191.09,"I am great.","Men zo'rman."],[191.48,193.58,"You know Pete, I am new to D.C.","Bilasizmi, Pete, men Vashingtonga yangi kelganman."],[193.48,196.55,"The city is big.","Shahar katta."],[197.3,200.71,"Yeah, but you learn a little more every day.","Ha, lekin har kuni bir oz ko'proq o'rganasiz."],[201.18,202.41,"How's the new apartment?","Yangi kvartira qanday?"],[202.46,204.33,"The new apartment is great.","Yangi kvartira zo'r."],[204.82,206.25,"Let's get coffee.","Keling, qahva ichaylik."],[206.78,209.41,"Anna, do you have a pen?","Anna, sizda ruchka bormi?"],[220.8,222.89,"It is not a pen.","Bu ruchka emas."],[223.06,224.53,"It is a book.","Bu kitob."],[225.38,227.51,"It is a big book.","Bu katta kitob."],[227.82,229.47,"Yes, yes it is, Pete.","Ha, ha, shunday, Pete."],[229.64,231.51,"I know I have a pen, though.","Lekin bilaman, menda ruchka bor."],[235.22,243.28,"I have a...","Menda bir..."],[243.18,248.35,"It is not a pen, Anna.","Bu ruchka emas, Anna."],[249.22,250.35,"A toy?","O'yinchoqmi?"],[250.39,254.78,"I have a...","Menda bir..."],[254.68,257.57,"And it is a pillow.","Bu esa yostiq."],[260.12,263.37,"Pete, Marsha, I know I have a pen.","Pete, Marsha, bilaman, menda ruchka bor."],[265.88,270.73,"Anna, it is a map.","Anna, bu xarita."],[272.56,276.01,"Why do you have a map of the world?","Nega sizda dunyo xaritasi bor?"],[276.32,281.31,"Pete, Marsha, now I know I have a pen.","Pete, Marsha, endi bilaman, menda ruchka bor."],[284.76,289.09,"And now you have a lamp.","Endi esa sizda chiroq bor."],[289.66,290.71,"Anna, Anna.","Anna, Anna."],[291.52,292.97,"I have a pen.","Menda ruchka bor."],[293.42,294.57,"Let's get coffee.","Keling, qahva ichaylik."]]},{"n":5,"t":"Where Are You?","uz":"uy xonalari","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/c/ce/ce630bdd-1ffd-4c63-aca7-4bdff50fc7ba.mp4","poster":"https://gdb.voanews.com/ce630bdd-1ffd-4c63-aca7-4bdff50fc7ba_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-5-where-are-you/3168971.html","s":[[150.44,151.37,"Hello everyone!","Hammaga salom!"],[151.86,155.29,"Today my friend Marsha is at her friend's house.","Bugun do'stim Marsha o'z dugonasining uyida."],[155.44,157.59,"She says it is beautiful.","U uy chiroyli deydi."],[158.2,160.39,"I want to see this house.","Men bu uyni ko'rmoqchiman."],[161.16,162.37,"Here we are.","Mana, keldik."],[167.94,170.51,"Marsha, I am in the kitchen.","Marsha, men oshxonadaman."],[172.74,176.29,"It is a beautiful kitchen.","Bu chiroyli oshxona."],[176.92,178.81,"It is beautiful.","U chiroyli."],[179.18,182.73,"We cook in the kitchen.","Biz oshxonada ovqat pishiramiz."],[185.26,187.53,"I eat in the kitchen.","Men oshxonada ovqatlanaman."],[188.2,191.19,"We relax in the living room.","Biz mehmonxonada dam olamiz."],[192.06,196.71,"I relax in the living room.","Men mehmonxonada dam olaman."],[197.18,199.91,"Marsha, let's go upstairs.","Marsha, keling, yuqoriga chiqaylik."],[207.46,210.04,"Anna, where are you?","Anna, qayerdasiz?"],[209.94,212.09,"Marsha, I am in the bathroom.","Marsha, men hammomdaman."],[212.28,214.43,"I wash in the bathroom.","Men hammomda yuvinaman."],[220.82,223.01,"I am in the bedroom.","Men yotoqxonadaman."],[223.46,226.21,"We sleep in the bedroom.","Biz yotoqxonada uxlaymiz."],[227.74,229.73,"I sleep in the bedroom.","Men yotoqxonada uxlayman."]]},{"n":6,"t":"Where Is the Gym?","uz":"joy so'rash","dur":300.3,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/1/11/11171870-8eee-4a24-bef4-41af1b6898a0.mp4","poster":"https://gdb.voanews.com/11171870-8eee-4a24-bef4-41af1b6898a0_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-6-where-is-the-gym-/5781378.html","s":[[21.06,26.84,"Hi there, I'm Anna and I live in Washington, D.C.","Salom, men Annaman, Vashingtonda yashayman."],[26.74,31.57,"Every day I learn more about this great city.","Har kuni bu ajoyib shahar haqida ko'proq bilib olaman."],[32.32,36.11,"People in Washington like to work out.","Vashingtonda odamlar sport bilan shug'ullanishni yaxshi ko'radi."],[36.84,37.97,"Oh!","Oh!"],[38.56,40.87,"Hi, Pete, how's it going?","Salom, Pete, ishlar qalay?"],[41.02,43.81,"Hi, Anna, it's going great.","Salom, Anna, ishlar zo'r."],[44.56,46.11,"How's it going with you?","Siznikida-chi, ishlar qalay?"],[46.42,48.09,"Things are awesome.","Hammasi a'lo."],[48.46,51.39,"Pete, I want to work out.","Pete, men sport bilan shug'ullanmoqchiman."],[51.78,52.76,"Where is the gym?","Sport zali qayerda?"],[52.66,55.95,"The gym is across from the lounge.","Sport zali dam olish xonasining qarshisida."],[56.42,58.77,"It's next to the mail room.","U pochta xonasining yonida."],[59.36,61.43,"Go that way. Thanks, Pete.","U tomonga boring. — Rahmat, Pete."],[62.34,64.93,"No, Anna, not that way.","Yo'q, Anna, u tomonga emas."],[65.4,67.15,"Go that way.","U tomonga boring."],[94.16,99.19,"Oh, Pete, this is not the gym.","Oh, Pete, bu sport zali emas."],[99.66,103.17,"That's right, Anna, this is the mail room.","To'g'ri, Anna, bu pochta xonasi."],[104.08,107.77,"The gym is across from what?","Sport zali nimaning qarshisida?"],[107.86,110.52,"The gym is across from the lounge.","Sport zali dam olish xonasining qarshisida."],[110.42,114.27,"Across from the lounge.","Dam olish xonasining qarshisida."],[114.88,118.07,"Right, thanks.","Xo'p, rahmat."],[130.3,136.76,"Pete, this is not the gym.","Pete, bu sport zali emas."],[136.66,143.35,"The gym is across from the lounge.","Sport zali dam olish xonasining qarshisida."],[144.14,146.67,"It is behind the lobby.","U kirish zalining orqasida."],[147.98,149.69,"Right, right.","Ha, ha."],[150.64,151.67,"See you.","Ko'rishguncha."],[152.22,153.67,"See you, Anna.","Ko'rishguncha, Anna."],[186.36,189.11,"This is not the gym.","Bu sport zali emas."],[190.2,193.21,"This is a parking garage.","Bu avtoturargoh."],[195.34,196.29,"Hello?","Allo?"],[198.08,199.13,"Pete?","Pete?"],[210.42,213.59,"This is not a gym.","Bu sport zali emas."],[214.46,216.75,"This is a rooftop.","Bu tom."],[220.58,221.91,"Pete?","Pete?"],[228.1,229.43,"Pete?","Pete?"],[230.76,232.77,"I want to work out too.","Men ham sport bilan shug'ullanmoqchiman."],[233.7,234.75,"Join me.","Menga qo'shiling."],[235.38,236.43,"I'm good.","Kerak emas, rahmat."]]},{"n":7,"t":"What Are You Doing?","uz":"yangi ish","dur":299.5,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/6/69/690103ea-ce31-4425-97c1-65af2fff6ffd.mp4","poster":"https://gdb.voanews.com/690103ea-ce31-4425-97c1-65af2fff6ffd_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-7-what-are-you-doing-/5781372.html","s":[[18.64,20.37,"Hello everyone!","Hammaga salom!"],[20.72,23.19,"Today I start my new job!","Bugun yangi ishimni boshlayman!"],[24.44,27.49,"I meet my new boss and my co-workers.","Yangi boshlig'im va hamkasblarim bilan tanishaman."],[27.82,29.39,"I am excited!","Juda xursandman!"],[29.58,31.89,"But nervous!","Lekin hayajondaman!"],[33.88,34.99,"Here I go!","Qani, boshladik!"],[46.82,49.25,"Come in!","Kiring!"],[52.68,54.83,"Well, Anna.","Xo'sh, Anna."],[55.62,57.33,"Welcome. Thank you.","Xush kelibsiz. — Rahmat."],[57.96,60.93,"I am your boss, Katie Weaver.","Men sizning boshlig'ingiz, Keti Uiverman."],[61.12,63.25,"But please, call me Katie.","Lekin iltimos, meni Keti deb chaqiring."],[63.44,64.73,"Thank you, Ms. Weaver.","Rahmat, Uiver xonim."],[65.52,68.85,"Just Katie. Sure thing, Ms. Weaver.","Shunchaki Keti. — Albatta, Uiver xonim."],[69.74,72.21,"Okay then, are you excited?","Xo'p, xursandmisiz?"],[72.54,74.77,"Yes, I am excited.","Ha, juda xursandman."],[75.48,78.45,"So sorry, but I am busy.","Kechirasiz, lekin men bandman."],[78.9,80.85,"Please, meet your co-workers.","Iltimos, hamkasblaringiz bilan tanishing."],[81.18,84.49,"But remember, they are busy working.","Lekin esda tuting, ular ish bilan band."],[84.94,87.31,"Sure. Thanks, Ms. Weaver.","Albatta. Rahmat, Uiver xonim."],[95.4,97.69,"Hi there! I am Anna.","Salom! Men Annaman."],[98.0,99.99,"Hi, Anna. I am Anne.","Salom, Anna. Men Ennman."],[100.32,102.43,"Nice to meet you. What are you doing?","Tanishganimdan xursandman. Nima qilyapsiz?"],[102.46,105.35,"I am writing. You are writing.","Men yozyapman. — Siz yozyapsiz."],[105.34,107.33,"You are writing a lot.","Siz ko'p yozyapsiz."],[107.64,108.49,"Oh dear.","Voy."],[108.96,110.83,"No, no. I am sorry. That's okay.","Yo'q, yo'q. Kechirasiz. — Hechqisi yo'q."],[110.88,115.97,"That's okay. Really. Please, please, please, please stop.","Hechqisi yo'q. Rostdan. Iltimos, iltimos, to'xtang."],[118.74,119.57,"Sorry.","Kechirasiz."],[120.98,121.87,"Sorry.","Kechirasiz."],[145.74,153.06,"And people all around the world are waiting to hear news about the next president.","Butun dunyo odamlari keyingi prezident haqidagi yangiliklarni kutmoqda."],[152.96,155.31,"Jonathan, hi! Remember me?","Jonatan, salom! Meni eslaysizmi?"],[155.22,156.77,"I live in your building.","Men siz bilan bir binoda yashayman."],[157.08,159.18,"Oh, hi, Anna.","Oh, salom, Anna."],[159.08,160.61,"What are you doing?","Nima qilyapsiz?"],[160.7,162.93,"I am doing my show.","Men ko'rsatuvimni olib boryapman."],[163.48,164.81,"Oh, sorry.","Oh, kechirasiz."],[164.92,166.27,"Are you recording?","Yozib olyapsizmi?"],[166.58,169.9,"Yes, and now I have to record again.","Ha, endi qaytadan yozib olishim kerak."],[169.8,172.79,"Sorry. Have a good show.","Kechirasiz. Ko'rsatuvingiz yaxshi o'tsin."],[173.32,174.11,"Thank you.","Rahmat."],[174.48,175.27,"Sorry.","Kechirasiz."],[182.02,184.95,"The word of the day is social.","Kunning so'zi — «social»."],[185.84,187.53,"Social is an adjective.","«Social» — sifat."],[188.1,190.69,"I am Anna. Hi, I am Amelia.","Men Annaman. — Salom, men Ameliyaman."],[190.74,191.99,"Nice to meet you.","Tanishganimdan xursandman."],[192.64,193.87,"What are you doing?","Nima qilyapsiz?"],[194.3,195.67,"I am reading.","Men o'qiyapman."],[196.14,197.69,"Are you reading the news?","Yangiliklarni o'qiyapsizmi?"],[198.0,201.55,"Hi. No, I am reading for my show.","Salom. — Yo'q, ko'rsatuvim uchun o'qiyapman."],[204.04,205.89,"Can I read again?","Qaytadan o'qisam bo'ladimi?"],[206.9,207.59,"Sorry.","Kechirasiz."],[208.92,211.93,"This day is not going well.","Bugun kun yaxshi o'tmayapti."],[236.78,237.87,"Anna!","Anna!"],[238.66,239.59,"Hi.","Salom."],[240.04,241.19,"What are you doing?","Nima qilyapsiz?"],[242.0,244.53,"I am bothering people, Ms. Weaver.","Odamlarni bezovta qilyapman, Uiver xonim."],[246.3,249.09,"Let's go to my office and talk.","Kabinetimga yuring, gaplashamiz."],[250.02,252.23,"I'd like to talk with you, Ms. Weaver.","Siz bilan gaplashmoqchiman, Uiver xonim."],[252.96,253.93,"It's Katie.","Men Ketiman."],[254.44,257.75,"Right. Thanks, Ms. Weaver.","Ha. Rahmat, Uiver xonim."]]},{"n":8,"t":"Are You Busy?","uz":"uzr so'rash","dur":300.0,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/d/da/daba2df2-95ca-4c88-923f-0b967553558a.mp4","poster":"https://gdb.voanews.com/daba2df2-95ca-4c88-923f-0b967553558a_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-8-are-you-busy-/5781370.html","s":[[20.44,21.93,"Hello everyone.","Hammaga salom."],[22.08,24.31,"Here I am at my new job.","Mana, yangi ishimdaman."],[24.78,27.65,"Yesterday, at my first day of work.","Kecha, ishdagi birinchi kunimda."],[28.2,30.11,"I'm sorry. That's okay.","Kechirasiz. — Hechqisi yo'q."],[30.08,31.33,"That's okay. Really?","Hechqisi yo'q. — Rostdanmi?"],[32.08,32.45,"Yes.","Ha."],[32.96,35.29,"And now I have to record again.","Endi esa qaytadan yozib olishim kerak."],[35.7,38.68,"No. I'm reading for my show.","Yo'q. Men ko'rsatuvim uchun o'qiyapman."],[38.58,40.17,"Let's not talk about yesterday.","Kecha haqida gapirmaylik."],[40.44,42.25,"Today is a new day.","Bugun yangi kun."],[42.5,45.95,"Today, I want to apologize to my coworkers.","Bugun hamkasblarimdan uzr so'ramoqchiman."],[49.44,51.74,"Hi, Anne. Are you busy?","Salom, Enn. Bandmisiz?"],[51.64,53.99,"Hi Anna. Yes.","Salom, Anna. Ha."],[54.02,56.69,"At 10 a.m., I am writing.","Soat 10 da men yozaman."],[57.2,59.99,"Every day, I do my morning show.","Har kuni ertalabki ko'rsatuvimni olib boraman."],[60.52,61.37,"Sorry.","Kechirasiz."],[61.94,62.69,"Okay.","Xo'p."],[63.24,64.25,"See you later.","Keyinroq ko'rishamiz."],[65.2,65.87,"Maybe.","Balki."],[66.66,68.43,"Maybe I'll see you later.","Balki keyinroq ko'rishamiz."],[83.1,84.49,"Hi, Jonathan.","Salom, Jonatan."],[84.78,85.77,"Are you busy?","Bandmisiz?"],[85.98,87.39,"Yes. I'm busy.","Ha. Bandman."],[87.56,91.97,"When the studio light is on, I am recording my evening show.","Studiya chirog'i yonib tursa, men kechki ko'rsatuvimni yozib olayotgan bo'laman."],[92.1,94.35,"Right. Sorry about yesterday.","Xo'p. Kecha uchun kechirasiz."],[94.54,97.0,"No worries. May I see the studio?","Hechqisi yo'q. — Studiyani ko'rsam bo'ladimi?"],[96.9,98.55,"Maybe another time.","Balki boshqa safar."],[98.62,100.57,"Right now, I am busy.","Hozir bandman."],[101.16,102.87,"Sure. Okay.","Albatta. Xo'p."],[103.16,104.69,"Bye. Bye.","Xayr. — Xayr."],[136.64,138.21,"Hi, Amelia.","Salom, Ameliya."],[138.46,139.61,"Are you busy?","Bandmisiz?"],[139.74,143.99,"I'm a little busy. I want to say, I'm sorry.","Biroz bandman. — Uzr so'ramoqchiman."],[144.26,146.99,"For yesterday. It's okay, Anna.","Kecha uchun. — Hechqisi yo'q, Anna."],[147.2,148.65,"Well, I am sorry.","Baribir, kechirasiz."],[148.84,151.51,"It's okay, Anna. Come by this afternoon.","Hechqisi yo'q, Anna. Tushdan keyin kiring."],[151.94,152.71,"Okay.","Xo'p."],[181.56,182.53,"Anna.","Anna."],[183.32,184.77,"Yes, Ms. Weaver.","Ha, Uiver xonim."],[184.74,185.75,"Are you busy?","Bandmisiz?"],[185.74,188.03,"Yes, Ms. Weaver. I am busy.","Ha, Uiver xonim. Bandman."],[188.14,190.23,"My office. 5 p.m.","Kabinetimga. Soat 5 da."],[192.24,193.53,"5 p.m.","Soat 5 da."],[209.26,211.63,"Come in.","Kiring."],[212.3,213.67,"Surprise!","Kutilmagan sovg'a!"],[214.8,216.55,"A party!","Bayram!"],[216.72,217.51,"Awesome!","Zo'r!"],[218.44,220.83,"And I still have my job.","Va ishim ham joyida."],[222.04,223.27,"Until next time.","Keyingi safargacha."]]},{"n":9,"t":"Is It Cold?","uz":"ob-havo","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/a/a1/a134ed92-a3e1-4e8e-abed-0c5ac229acba.mp4","poster":"https://gdb.voanews.com/a134ed92-a3e1-4e8e-abed-0c5ac229acba_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-9-is-it-cold-/5781346.html","s":[[177.74,179.63,"Oh, hi, everyone.","Oh, hammaga salom."],[180.74,185.15,"Here in Washington, D.C., the weather changes often.","Vashingtonda ob-havo tez-tez o'zgaradi."],[185.32,191.55,"One day is cold and windy, but the next day is warm and sunny.","Bir kuni sovuq va shamolli, keyingi kuni esa iliq va quyoshli."],[192.94,195.77,"So, every day, I check the forecast.","Shuning uchun har kuni ob-havo ma'lumotini tekshiraman."],[198.04,201.03,"Hello, phone. What is today's temperature?","Salom, telefon. Bugun harorat qancha?"],[201.58,203.86,"Today, it is 18 degrees.","Bugun 18 daraja."],[203.76,205.19,"18 degrees?","18 daraja?"],[205.58,206.81,"That is cold.","Bu sovuq-ku."],[207.2,209.03,"18 degrees Celsius.","Selsiy bo'yicha 18 daraja."],[209.44,214.05,"Oh, Celsius. That is 65 degrees Fahrenheit.","Oh, Selsiy. Bu Farengeyt bo'yicha 65 daraja."],[214.24,216.51,"That's warm. Yes, Anna.","Bu iliq. — Ha, Anna."],[216.72,218.13,"It is warm.","Havo iliq."],[218.34,221.65,"Excuse me, phone. Is it windy today?","Kechirasiz, telefon. Bugun shamol bormi?"],[222.18,225.37,"No, it is not windy today.","Yo'q, bugun shamol yo'q."],[225.76,227.87,"Is it sunny today?","Bugun quyoshlimi?"],[228.18,231.07,"Yes, Anna. It is sunny.","Ha, Anna. Havo quyoshli."],[231.58,234.49,"Excuse me, phone. Yes, Anna.","Kechirasiz, telefon. — Ha, Anna."],[234.98,236.85,"Is it snowy today?","Bugun qor yog'adimi?"],[237.3,240.51,"No, Anna. It is not snowy.","Yo'q, Anna. Qor yog'maydi."],[241.36,242.39,"Thank you, phone.","Rahmat, telefon."],[243.26,246.33,"Today, the weather is warm and sunny.","Bugun havo iliq va quyoshli."],[246.58,249.47,"Great for seeing Washington, D.C.","Vashingtonni aylanish uchun juda yaxshi."],[251.08,254.57,"Phone. It is not warm and sunny.","Telefon. Havo iliq ham, quyoshli ham emas."],[254.84,259.02,"It is cold and windy and snowy.","Sovuq, shamolli va qor yog'yapti."],[258.92,263.89,"Anna, it is not cold, windy, or snowy.","Anna, havo sovuq ham, shamolli ham, qorli ham emas."],[264.14,270.49,"It is warm and sunny in Mexico City, Mexico.","Meksikada, Mexiko shahrida havo iliq va quyoshli."],[271.1,273.29,"Oh, I see.","Oh, tushundim."],[274.04,274.91,"Mexico.","Meksika."],[276.6,279.39,"Washington weather changes often.","Vashingtonda ob-havo tez-tez o'zgaradi."],[279.8,281.93,"Remember to check the forecast.","Ob-havo ma'lumotini tekshirishni unutmang."],[282.42,284.15,"The right forecast.","To'g'ri ma'lumotni."],[284.36,288.52,"Yes, Anna. Next time, remember to check the forecast.","Ha, Anna. Keyingi safar ob-havoni tekshirishni unutmang."],[288.42,290.09,"Thank you, phone.","Rahmat, telefon."],[290.48,291.35,"Goodbye, phone.","Xayr, telefon."],[292.54,294.29,"Until next time.","Keyingi safargacha."],[294.44,297.01,"Yes, until next time.","Ha, keyingi safargacha."]]},{"n":10,"t":"Come Over to My Place","uz":"yo'l ko'rsatish","dur":300.0,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/b/b3/b34664a8-fabc-4541-8be9-438f0d466626.mp4","poster":"https://gdb.voanews.com/b34664a8-fabc-4541-8be9-438f0d466626_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/let-s-learn-english---level-1---lesson-10-come-over-to-my-place/5781340.html","s":[[206.64,207.73,"Hi.","Salom."],[208.34,210.85,"Today my friend Ashley is coming over.","Bugun dugonam Eshli mehmonga keladi."],[211.16,213.45,"I am showing her my new apartment.","Unga yangi kvartiramni ko'rsataman."],[215.38,217.07,"That's Ashley calling.","Bu Eshli qo'ng'iroq qilyapti."],[218.44,219.83,"Hi, Ashley.","Salom, Eshli."],[219.88,222.55,"Hi Anna. I am coming to your apartment.","Salom, Anna. Kvartirangga kelyapman."],[223.16,224.65,"Where is your apartment?","Kvartirang qayerda?"],[224.86,228.49,"My apartment is near the Columbia Heights Metro.","Kvartiram Kolumbiya Xayts metrosi yaqinida."],[228.92,231.39,"It is near the Columbia Heights Metro?","Kolumbiya Xayts metrosi yaqinidami?"],[231.56,234.21,"Yes. Exit the Metro and turn right.","Ha. Metrodan chiqib, o'ngga buril."],[234.48,237.23,"Then at the bus station turn left.","Keyin avtobus bekatida chapga buril."],[237.44,239.03,"Then walk straight ahead.","Keyin to'g'riga yur."],[239.52,240.17,"Okay.","Xo'p."],[240.54,243.82,"Exit Metro, turn right, turn left.","Metrodan chiqaman, o'ngga, keyin chapga buraman."],[243.72,245.13,"Then go straight ahead.","Keyin to'g'riga yuraman."],[245.6,249.45,"Yes. My apartment is near a coffee shop.","Ha. Kvartiram bir qahvaxona yaqinida."],[250.24,251.35,"See you soon.","Tez orada ko'rishamiz."],[254.2,255.71,"Hi, Ashley.","Salom, Eshli."],[255.66,257.99,"Hello, Anna. Which coffee shop?","Salom, Anna. Qaysi qahvaxona?"],[258.0,260.17,"There are three coffee shops.","Bu yerda uchta qahvaxona bor."],[260.52,265.15,"Okay. My apartment is across from a big department store.","Xo'p. Kvartiram katta univermag qarshisida."],[265.18,266.97,"A big department store?","Katta univermagmi?"],[267.12,269.07,"Ah. I see it.","A. Ko'ryapman."],[269.02,271.25,"Okay. Bye, Ashley. See you soon.","Xo'p. Xayr, Eshli. Tez orada ko'rishamiz."],[271.58,273.39,"Okay. See you soon.","Xo'p. Tez orada ko'rishamiz."],[274.76,275.71,"Okay.","Xo'p."],[279.26,280.61,"Ashley!","Eshli!"],[281.0,281.57,"Ashley!","Eshli!"],[282.2,283.03,"Ashley!","Eshli!"],[283.38,284.61,"Over here!","Men bu yerdaman!"],[286.24,286.87,"Donna!","Donna!"],[287.22,288.87,"Hi! Oh!","Salom! Oh!"],[291.02,293.87,"I love having my friends over.","Do'stlarimni mehmonga chaqirishni yaxshi ko'raman."],[294.66,295.52,"Come on!","Qani, yuringlar!"]]}],"src":"VOA Learning English — Let's Learn English, Level 1 (learningenglish.voanews.com). Vaqtlar: Whisper (small.en). Tarjima: qo'lda."}