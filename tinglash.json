{"lessons":[{"n":1,"t":"Welcome!","uz":"tanishuv","dur":300.4,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/5/5f/5f00c78a-0f84-41e6-949d-bd808bcadf50.mp4","poster":"https://gdb.voanews.com/5f00c78a-0f84-41e6-949d-bd808bcadf50_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-one/3111026.html","s":[[200.78,202.63,"Hi, are you Anna?","Salom, siz Annamisiz?"],[202.7,204.53,"Yes. Hi there. Are you Pete?","Ha. Salom. Siz Petemisiz?"],[204.66,206.62,"I am Pete. Nice to meet you.","Men Peteman. Tanishganimdan xursandman."],[206.52,210.23,"Oh, let's try that again.","Oh, keling, qaytadan urinib ko'raylik."],[211.0,213.13,"I'm Anna. Nice to meet you.","Men Annaman. Tanishganimdan xursandman."],[213.16,214.09,"I'm Pete.","Men Peteman."],[214.66,217.25,"Anna, is that A-N-A?","Anna — bu A-N-A mi?"],[217.26,219.83,"No, A-N-N-A.","Yo'q, A-N-N-A."],[220.16,222.15,"Well, Anna with two n's.","Xo'p, ikkita «n» bilan Anna."],[222.66,226.59,"Welcome to 1400 Irving Street.","Irving ko'chasi, 1400-uyga xush kelibsiz."],[226.9,228.55,"My new apartment.","Mening yangi kvartiram."],[229.04,229.67,"Yes.","Ha."]]},{"n":2,"t":"Hello, I'm Anna!","uz":"tanishtirish","dur":300.4,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2021/02/4/42/4298a2ba-d665-4b1c-aaa1-502bbcb9b88d.mp4","poster":"https://gdb.voanews.com/4298a2ba-d665-4b1c-aaa1-502bbcb9b88d_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-2-hello/3113733.html","s":[[169.96,171.05,"Hi. Hey, Pete.","Salom. — Salom, Pete."],[171.42,172.49,"Who's your friend?","Do'stingiz kim?"],[173.0,175.27,"She is Anna. She is new to D.C.","Bu Anna. U Vashingtonga (D.C.) yangi kelgan."],[175.56,176.6,"Where are you from?","Qayerdansiz?"],[176.5,178.99,"I am from a small town.","Men kichik bir shaharchadanman."],[180.0,181.99,"Welcome to D.C. Thank you.","Vashingtonga xush kelibsiz. — Rahmat."],[182.02,182.93,"I'm Jonathan.","Men Jonatanman."],[183.4,185.09,"I'm in apartment B4.","Men B4-kvartiradaman."],[185.64,187.73,"I am in apartment C2.","Men C2-kvartiradaman."],[188.02,189.81,"Marsha is my roommate.","Marsha mening xonadoshim."],[190.38,191.73,"I know Marsha.","Men Marshani taniyman."],[191.9,193.09,"She is nice.","U yoqimli."],[193.88,196.77,"And I am in apartment D7.","Men esa D7-kvartiradaman."],[197.52,199.21,"I have to go now.","Men hozir ketishim kerak."],[199.2,199.93,"Oh.","O."],[200.42,202.47,"Remember to call Marsha at work.","Marshaga ishiga qo'ng'iroq qilishni unutmang."],[202.48,203.9,"Tell her you're here.","Unga shu yerdaligingizni ayting."],[203.8,205.14,"Right. Thanks, Pete.","Xo'p. Rahmat, Pete."],[205.04,207.04,"Nice to meet you.","Tanishganimdan xursandman."],[206.94,208.35,"You too. Bye.","Men ham. Xayr."],[210.58,213.81,"Apartment C2, here I come.","C2-kvartira, men kelyapman."]]},{"n":3,"t":"I'm Here!","uz":"uzr so'rash, telefonda","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/0/02/027f8fdd-e9b0-409c-8618-45be49fcefe8.mp4","poster":"https://gdb.voanews.com/027f8fdd-e9b0-409c-8618-45be49fcefe8_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-3-i-am-here/3126527.html","s":[[187.41,190.31,"I am in my new apartment.","Men yangi kvartiramdaman."],[190.66,191.37,"Great.","Zo'r."],[191.8,193.37,"I live with Marsha.","Men Marsha bilan yashayman."],[193.56,195.25,"We're roommates.","Biz xonadoshmiz."],[196.18,198.39,"I want to cook dinner.","Men kechki ovqat pishirmoqchiman."],[204.04,209.25,"Oh, is there a supermarket near here?","Oh, shu yaqin atrofda supermarket bormi?"],[210.36,211.37,"Marsha knows.","Marsha biladi."],[214.06,219.49,"Marsha's work number is 555-8986.","Marshaning ish raqami 555-8986."],[222.58,223.75,"Hello.","Allo."],[224.16,225.79,"Is this Marsha?","Bu Marshami?"],[225.74,227.89,"It is Anna. I am sorry.","Bu Anna. — Kechirasiz."],[227.84,229.31,"You have the wrong number.","Siz noto'g'ri raqam terdingiz."],[229.66,233.53,"Is this 555-8986?","Bu 555-8986 mi?"],[234.26,238.17,"No. This is 555-8689.","Yo'q. Bu 555-8689."],[239.42,241.42,"Oh, excuse me.","Oh, kechirasiz."],[241.32,242.39,"Okay. Bye.","Xo'p. Xayr."],[243.5,245.41,"One more time.","Yana bir marta."],[250.76,252.39,"Please be Marsha.","Iltimos, Marsha bo'lsin."],[255.12,257.4,"Hello. This is Marsha.","Allo. Bu Marsha."],[257.3,260.45,"Yes, Marsha. I want to cook dinner.","Ha, Marsha. Men kechki ovqat pishirmoqchiman."],[260.64,261.57,"Excuse me?","Nima dedingiz?"],[261.86,263.35,"Anna, is that you?","Anna, bu sizmisiz?"],[263.3,264.99,"Oh, yes. I am here.","Oh, ha. Men shu yerdaman."],[265.18,267.07,"Good. You are there.","Yaxshi. Siz u yerdasiz."],[267.22,270.03,"I want to find a supermarket.","Men supermarket topmoqchiman."],[270.1,271.49,"Oh, okay.","Oh, xo'p."],[271.68,276.41,"The supermarket is at 1500 Irving Street.","Supermarket Irving ko'chasi, 1500-uyda."],[276.52,278.35,"It is near the apartment.","U kvartiraga yaqin."],[278.54,279.13,"Great.","Zo'r."],[279.74,281.61,"Goodbye. Goodbye, Anna.","Xayr. — Xayr, Anna."],[283.56,288.07,"There is a big supermarket on our street.","Ko'chamizda katta supermarket bor."],[288.04,291.89,"And Marsha says, I am a good cook.","Marsha esa men yaxshi oshpazman deydi."],[293.0,295.09,"Until next time, bye.","Keyingi safargacha, xayr."]]},{"n":4,"t":"What Is It?","uz":"kundalik narsalar","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/c/c8/c829a13b-9764-4b89-ad70-1edbdc3d8013.mp4","poster":"https://gdb.voanews.com/c829a13b-9764-4b89-ad70-1edbdc3d8013_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-4/3168920.html","s":[[174.16,183.87,"Pete, hi.","Pete, salom."],[183.82,185.41,"Hi. We are here.","Salom. Biz keldik."],[185.7,187.23,"Hi, Anna. Hi, Marsha.","Salom, Anna. Salom, Marsha."],[187.32,187.89,"Hi.","Salom."],[188.48,189.93,"How are you two?","Ikkalangiz qalaysiz?"],[189.92,191.09,"I am great.","Men zo'rman."],[191.48,193.58,"You know Pete, I am new to D.C.","Bilasizmi, Pete, men Vashingtonga yangi kelganman."],[193.48,196.55,"The city is big.","Shahar katta."],[197.3,200.71,"Yeah, but you learn a little more every day.","Ha, lekin har kuni bir oz ko'proq o'rganasiz."],[201.18,202.41,"How's the new apartment?","Yangi kvartira qanday?"],[202.46,204.33,"The new apartment is great.","Yangi kvartira zo'r."],[204.82,206.25,"Let's get coffee.","Keling, qahva ichaylik."],[206.78,209.41,"Anna, do you have a pen?","Anna, sizda ruchka bormi?"],[220.8,222.89,"It is not a pen.","Bu ruchka emas."],[223.06,224.53,"It is a book.","Bu kitob."],[225.38,227.51,"It is a big book.","Bu katta kitob."],[227.82,229.47,"Yes, yes it is, Pete.","Ha, ha, shunday, Pete."],[229.64,231.51,"I know I have a pen, though.","Lekin bilaman, menda ruchka bor."],[235.22,243.28,"I have a...","Menda bir..."],[243.18,248.35,"It is not a pen, Anna.","Bu ruchka emas, Anna."],[249.22,250.35,"A toy?","O'yinchoqmi?"],[250.39,254.78,"I have a...","Menda bir..."],[254.68,257.57,"And it is a pillow.","Bu esa yostiq."],[260.12,263.37,"Pete, Marsha, I know I have a pen.","Pete, Marsha, bilaman, menda ruchka bor."],[265.88,270.73,"Anna, it is a map.","Anna, bu xarita."],[272.56,276.01,"Why do you have a map of the world?","Nega sizda dunyo xaritasi bor?"],[276.32,281.31,"Pete, Marsha, now I know I have a pen.","Pete, Marsha, endi bilaman, menda ruchka bor."],[284.76,289.09,"And now you have a lamp.","Endi esa sizda chiroq bor."],[289.66,290.71,"Anna, Anna.","Anna, Anna."],[291.52,292.97,"I have a pen.","Menda ruchka bor."],[293.42,294.57,"Let's get coffee.","Keling, qahva ichaylik."]]},{"n":5,"t":"Where Are You?","uz":"uy xonalari","dur":300.1,"video":"https://voa-video-ns.akamaized.net/pangeavideo/2016/05/c/ce/ce630bdd-1ffd-4c63-aca7-4bdff50fc7ba.mp4","poster":"https://gdb.voanews.com/ce630bdd-1ffd-4c63-aca7-4bdff50fc7ba_tv_w650_r1.jpg","page":"https://learningenglish.voanews.com/a/lets-learn-english-lesson-5-where-are-you/3168971.html","s":[[150.44,151.37,"Hello everyone!","Hammaga salom!"],[151.86,155.29,"Today my friend Marsha is at her friend's house.","Bugun do'stim Marsha o'z dugonasining uyida."],[155.44,157.59,"She says it is beautiful.","U uy chiroyli deydi."],[158.2,160.39,"I want to see this house.","Men bu uyni ko'rmoqchiman."],[161.16,162.37,"Here we are.","Mana, keldik."],[167.94,170.51,"Marsha, I am in the kitchen.","Marsha, men oshxonadaman."],[172.74,176.29,"It is a beautiful kitchen.","Bu chiroyli oshxona."],[176.92,178.81,"It is beautiful.","U chiroyli."],[179.18,182.73,"We cook in the kitchen.","Biz oshxonada ovqat pishiramiz."],[185.26,187.53,"I eat in the kitchen.","Men oshxonada ovqatlanaman."],[188.2,191.19,"We relax in the living room.","Biz mehmonxonada dam olamiz."],[192.06,196.71,"I relax in the living room.","Men mehmonxonada dam olaman."],[197.18,199.91,"Marsha, let's go upstairs.","Marsha, keling, yuqoriga chiqaylik."],[207.46,210.04,"Anna, where are you?","Anna, qayerdasiz?"],[209.94,212.09,"Marsha, I am in the bathroom.","Marsha, men hammomdaman."],[212.28,214.43,"I wash in the bathroom.","Men hammomda yuvinaman."],[220.82,223.01,"I am in the bedroom.","Men yotoqxonadaman."],[223.46,226.21,"We sleep in the bedroom.","Biz yotoqxonada uxlaymiz."],[227.74,229.73,"I sleep in the bedroom.","Men yotoqxonada uxlayman."]]}],"src":"VOA Learning English — Let's Learn English, Level 1 (learningenglish.voanews.com). Vaqtlar: Whisper (small.en). Tarjima: qo'lda."}